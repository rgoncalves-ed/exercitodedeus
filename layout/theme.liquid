<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#1A1A1A' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <title>
      {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Página {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- comment -%} Open Graph para compartilhamento em redes sociais {%- endcomment -%}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    {%- if page_description -%}
      <meta property="og:description" content="{{ page_description | escape }}">
    {%- endif -%}
    {%- if template contains 'product' and product.featured_image -%}
      <meta property="og:type" content="product">
      <meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 }}">
      <meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
      <meta property="product:price:currency" content="{{ shop.currency }}">
    {%- elsif template contains 'article' and article.image -%}
      <meta property="og:type" content="article">
      <meta property="og:image" content="{{ article.image | image_url: width: 1200 }}">
    {%- elsif settings.share_image -%}
      <meta property="og:type" content="website">
      <meta property="og:image" content="{{ settings.share_image | image_url: width: 1200 }}">
    {%- else -%}
      <meta property="og:type" content="website">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">

    {%- comment -%} Schema.org: Organization (em todas as páginas) {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}{% if settings.logo %},
      "logo": {{ settings.logo | image_url: width: 500 | prepend: 'https:' | json }}{% endif %}{% if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_youtube != blank %},
      "sameAs": [
        {% if settings.social_instagram != blank %}{{ settings.social_instagram | json }}{% if settings.social_facebook != blank or settings.social_youtube != blank %},{% endif %}{% endif %}
        {% if settings.social_facebook != blank %}{{ settings.social_facebook | json }}{% if settings.social_youtube != blank %},{% endif %}{% endif %}
        {% if settings.social_youtube != blank %}{{ settings.social_youtube | json }}{% endif %}
      ]{% endif %}
    }
    </script>

    {%- comment -%} Schema.org: WebSite com SearchAction {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    {%- comment -%} Schema.org: Product (só nas PDPs) {%- endcomment -%}
    {%- if template contains 'product' and product -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "image": [
          {% for img in product.images limit: 5 %}{{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}
        ],
        "description": {{ product.description | strip_html | truncate: 500 | json }},
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
        "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
        "offers": {
          "@type": "Offer",
          "url": "{{ shop.url }}{{ product.url }}",
          "priceCurrency": {{ shop.currency | json }},
          "price": "{{ product.price | divided_by: 100.0 }}",
          "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition"
        }
      }
      </script>
    {%- endif -%}

    {{ content_for_header }}

    {% style %}
      :root {
        --color-primary: {{ settings.color_primary | default: '#1A1A1A' }};
        --color-accent: {{ settings.color_accent | default: '#B91C1C' }};
        --color-background: {{ settings.color_background | default: '#FFFFFF' }};
        --color-surface: {{ settings.color_surface | default: '#F8F8F8' }};
        --color-text: {{ settings.color_text | default: '#1A1A1A' }};
        --color-text-muted: {{ settings.color_text_muted | default: '#6B6B6B' }};
        --color-border: {{ settings.color_border | default: '#E5E5E5' }};
        --font-body: Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --font-heading: Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --font-body-size: {{ settings.type_body_size | default: 15 }}px;
        --page-width: {{ settings.layout_page_width | default: 1280 }}px;
        --section-spacing: {{ settings.layout_spacing_sections | default: 80 }}px;
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template | replace: '.', '-' | handle }}">
    <a class="skip-to-content" href="#MainContent">Pular para o conteúdo</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'cookie-banner' %}
  </body>
</html>
