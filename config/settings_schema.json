[
  {
    "name": "theme_info",
    "theme_name": "Exército de Deus",
    "theme_version": "1.0.0",
    "theme_author": "Raphael",
    "theme_documentation_url": "https://shopify.dev/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Cores",
    "settings": [
      {
        "type": "header",
        "content": "Cores principais"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Cor primária (acento)",
        "default": "#564999"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Cor de destaque (links, ofertas)",
        "default": "#7EC0D5"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Fundo da página",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Fundo de seções alternadas",
        "default": "#F8F8F8"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Cor do texto",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Texto secundário",
        "default": "#6B6B6B"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Bordas",
        "default": "#E5E5E5"
      }
    ]
  },
  {
    "name": "Tipografia",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Fonte dos títulos",
        "default": "inter_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Fonte do corpo",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "type_body_size",
        "label": "Tamanho base do texto",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 15
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "layout_page_width",
        "label": "Largura máxima do conteúdo",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "range",
        "id": "layout_spacing_sections",
        "label": "Espaço entre seções",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 80
      }
    ]
  },
  {
    "name": "Cartões de produto",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Proporção da imagem",
        "options": [
          { "value": "portrait", "label": "Retrato (livros)" },
          { "value": "square", "label": "Quadrado" },
          { "value": "natural", "label": "Original" }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Mostrar editora/autor",
        "default": true
      },
      {
        "type": "header",
        "content": "Selos / badges nos cards"
      },
      {
        "type": "range",
        "id": "badge_new_days",
        "label": "Marcar como \"Novo\" se criado há até X dias",
        "min": 0,
        "max": 90,
        "step": 5,
        "default": 30,
        "info": "0 desativa o selo Novo."
      },
      {
        "type": "text",
        "id": "badge_bestseller_tag",
        "label": "Tag que ativa o selo \"Mais vendido\"",
        "default": "mais-vendido",
        "info": "Adicione essa tag no produto pra ele aparecer com o selo."
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Avisar estoque baixo a partir de",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 5,
        "info": "Mostra selo \"Último!\" / \"Restam X\" no card e aviso na página do produto. 0 desativa. Requer Shopify gerenciando o estoque."
      }
    ]
  },
  {
    "name": "Contato",
    "settings": [
      {
        "type": "paragraph",
        "content": "Esses dados aparecem na página /pages/contato (template page.contato). O e-mail das mensagens do formulário vai para o e-mail principal da loja em Admin → Configurações → Loja."
      },
      {
        "type": "text",
        "id": "contact_phone_number",
        "label": "Telefone exibido",
        "default": "(43) 9993-5389"
      },
      {
        "type": "text",
        "id": "contact_email_address",
        "label": "E-mail exibido",
        "default": "loja@grupoexercitodedeus.com.br"
      },
      {
        "type": "textarea",
        "id": "contact_address",
        "label": "Endereço",
        "default": "Rua Carmela Dutra 190, Jardim Morumbi, CEP 86036-360, Londrina/PR"
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "Horário de atendimento",
        "default": "Segunda a sexta, 9h às 18h"
      },
      {
        "type": "textarea",
        "id": "contact_map_embed",
        "label": "Embed do mapa (iframe Google Maps)",
        "info": "Cole o código de incorporação (iframe) do Google Maps aqui."
      }
    ]
  },
  {
    "name": "Redes sociais",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "default": "https://instagram.com/"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "default": "https://facebook.com/"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube",
        "default": ""
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "default": ""
      },
      {
        "type": "text",
        "id": "social_whatsapp",
        "label": "WhatsApp (número com DDI, ex: 5551999999999)",
        "default": ""
      },
      {
        "type": "text",
        "id": "social_spotify",
        "label": "Spotify (URL do artista/perfil)",
        "default": ""
      },
      {
        "type": "text",
        "id": "social_kwai",
        "label": "Kwai (URL do perfil)",
        "default": ""
      },
      {
        "type": "text",
        "id": "social_wa_channel",
        "label": "Canal do WhatsApp (URL completa)",
        "info": "Cole o link do canal (https://whatsapp.com/channel/...) — aparece como botão 'Participe do canal' no rodapé.",
        "default": ""
      }
    ]
  },
  {
    "name": "SEO / Compartilhamento",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Imagem padrão de compartilhamento",
        "info": "Aparece quando o site é compartilhado no WhatsApp, Facebook, etc. Recomendado: 1200×630px."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (também usada no Schema.org)",
        "info": "Usada no header e em microdados SEO."
      }
    ]
  },
  {
    "name": "Cookies / LGPD",
    "settings": [
      {
        "type": "paragraph",
        "content": "Lei brasileira (LGPD) exige aviso de cookies em todo site que coleta dados. O banner aparece uma vez por visitante, salva a preferência no navegador."
      },
      {
        "type": "checkbox",
        "id": "cookie_banner_enabled",
        "label": "Ativar banner de cookies",
        "default": true
      },
      {
        "type": "textarea",
        "id": "cookie_banner_text",
        "label": "Texto do banner",
        "default": "Usamos cookies pra melhorar sua experiência, lembrar suas preferências e analisar o uso do site. Ao continuar navegando, você concorda com nossa"
      },
      {
        "type": "url",
        "id": "cookie_policy_url",
        "label": "Link da política de privacidade (opcional, padrão: /policies/privacy-policy)"
      }
    ]
  },
  {
    "name": "Frete grátis",
    "settings": [
      {
        "type": "paragraph",
        "content": "Mostra uma barra de progresso no carrinho indicando quanto falta para o cliente ganhar frete grátis."
      },
      {
        "type": "checkbox",
        "id": "free_shipping_enabled",
        "label": "Ativar barra de frete grátis",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Valor mínimo (em reais)",
        "default": 199,
        "info": "Acima desse valor o cliente ganha frete grátis. Você precisa criar a regra de \"shipping rate\" no admin para que isso funcione no checkout — aqui é apenas o aviso visual."
      }
    ]
  },
  {
    "name": "Pagamentos extras",
    "settings": [
      {
        "type": "paragraph",
        "content": "Os ícones de cartão (Visa, Master, etc) vêm automaticamente das formas de pagamento ativas em Admin → Pagamentos. Pix e Boleto normalmente vêm via app externo — marque abaixo se sua loja aceita."
      },
      {
        "type": "checkbox",
        "id": "payment_show_pix",
        "label": "Aceitamos Pix",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "payment_show_boleto",
        "label": "Aceitamos Boleto",
        "default": true
      }
    ]
  }
]
