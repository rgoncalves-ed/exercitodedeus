{% doc %}
  @prompt
    Preciso que apareça botões que levem a categorias diferentes de produtos
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-buttons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-category-buttons__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-category-buttons__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-category-buttons__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  .ai-category-buttons__link-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    min-height: {{ block.settings.button_height }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .ai-category-buttons__link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-category-buttons__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: 12px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ai-category-buttons__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-buttons__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-buttons__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-buttons__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    text-align: center;
    margin: 0;
  }

  .ai-category-buttons__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    text-align: center;
    margin-top: 4px;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-category-buttons__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-category-buttons__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-category-buttons__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-category-buttons__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-category-buttons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-buttons__container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign category_enabled_key = 'category_' | append: i | append: '_enabled'
        assign category_collection_key = 'category_' | append: i | append: '_collection'
        assign category_title_key = 'category_' | append: i | append: '_title'
        assign category_description_key = 'category_' | append: i | append: '_description'
        assign category_image_key = 'category_' | append: i | append: '_image'

        assign category_enabled = block.settings[category_enabled_key]
        assign category_collection = block.settings[category_collection_key]
        assign category_title = block.settings[category_title_key]
        assign category_description = block.settings[category_description_key]
        assign category_image = block.settings[category_image_key]
      %}

      {% if category_enabled %}
        <div class="ai-category-buttons__item-{{ ai_gen_id }}">
          {% if category_collection != blank %}
            <a href="{{ category_collection.url }}" class="ai-category-buttons__link-{{ ai_gen_id }}">
              {% if category_image != blank %}
                <div class="ai-category-buttons__image-wrapper-{{ ai_gen_id }}">
                  <img
                    src="{{ category_image | image_url: width: 200 }}"
                    alt="{{ category_image.alt | default: category_title | escape }}"
                    class="ai-category-buttons__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                </div>
              {% else %}
                <div class="ai-category-buttons__image-wrapper-{{ ai_gen_id }}">
                  <div class="ai-category-buttons__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                </div>
              {% endif %}

              {% if category_title != blank %}
                <h3 class="ai-category-buttons__title-{{ ai_gen_id }}">{{ category_title }}</h3>
              {% else %}
                <h3 class="ai-category-buttons__title-{{ ai_gen_id }}">{{ category_collection.title }}</h3>
              {% endif %}

              {% if category_description != blank %}
                <p class="ai-category-buttons__description-{{ ai_gen_id }}">{{ category_description }}</p>
              {% endif %}
            </a>
          {% else %}
            <div class="ai-category-buttons__link-{{ ai_gen_id }}" style="cursor: default;">
              <div class="ai-category-buttons__image-wrapper-{{ ai_gen_id }}">
                <div class="ai-category-buttons__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              </div>
              <h3 class="ai-category-buttons__title-{{ ai_gen_id }}">
                {% if category_title != blank %}
                  {{ category_title }}
                {% else %}
                  Categoria {{ i }}
                {% endif %}
              </h3>
              {% if category_description != blank %}
                <p class="ai-category-buttons__description-{{ ai_gen_id }}">{{ category_description }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

