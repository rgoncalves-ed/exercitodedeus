<section class="page-width auth">
  <div class="auth__card">
    <header class="auth__head">
      <h1 class="auth__title">Redefinir senha</h1>
      <p class="auth__lead">Escolha uma nova senha pra sua conta.</p>
    </header>

    {% form 'reset_customer_password', class: 'auth__fields' %}
      {{ form.errors | default_errors }}

      <label class="auth__field">
        <span class="auth__label">Nova senha</span>
        <input type="password" name="customer[password]" autocomplete="new-password" minlength="5" required>
      </label>

      <label class="auth__field">
        <span class="auth__label">Confirmar nova senha</span>
        <input type="password" name="customer[password_confirmation]" autocomplete="new-password" minlength="5" required>
      </label>

      <button type="submit" class="btn btn--primary auth__submit">Redefinir senha</button>
    {% endform %}
  </div>
</section>
