<section class="page-width order-page">
  <a href="{{ routes.account_url }}" class="order-page__back">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    Voltar para minha conta
  </a>

  <header class="order-page__head">
    <div>
      <h1>Pedido #{{ order.name }}</h1>
      <p class="muted">Realizado em {{ order.created_at | date: '%d/%m/%Y às %H:%M' }}</p>
    </div>
    <div class="order-page__status-group">
      <span class="order-status order-status--{{ order.financial_status }}">
        {%- case order.financial_status -%}
          {%- when 'paid' -%}Pago
          {%- when 'pending' -%}Aguardando pagamento
          {%- when 'refunded' -%}Reembolsado
          {%- when 'voided' -%}Cancelado
          {%- else -%}{{ order.financial_status_label }}
        {%- endcase -%}
      </span>
      {%- if order.fulfillment_status_label != blank -%}
        <span class="order-status order-status--{{ order.fulfillment_status }}">{{ order.fulfillment_status_label }}</span>
      {%- endif -%}
    </div>
  </header>

  <div class="order-page__grid">
    {%- comment -%} Itens {%- endcomment -%}
    <div class="order-page__items">
      {%- for line in order.line_items -%}
        <article class="order-item">
          <a href="{{ line.product.url }}" class="order-item__media">
            {%- if line.image -%}
              <img src="{{ line.image | image_url: width: 160 }}" alt="{{ line.title | escape }}">
            {%- endif -%}
          </a>
          <div class="order-item__main">
            <a href="{{ line.product.url }}" class="order-item__title">{{ line.product.title }}</a>
            {%- unless line.variant.title contains 'Default' -%}
              <p class="muted order-item__variant">{{ line.variant.title }}</p>
            {%- endunless -%}
            <p class="muted">Qtd: {{ line.quantity }}</p>
            {%- if line.fulfillment.tracking_number != blank -%}
              <p class="order-item__tracking">
                Rastreio:
                {%- if line.fulfillment.tracking_url != blank -%}
                  <a href="{{ line.fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ line.fulfillment.tracking_number }}</a>
                {%- else -%}
                  <strong>{{ line.fulfillment.tracking_number }}</strong>
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
          <div class="order-item__price">{{ line.final_line_price | money }}</div>
        </article>
      {%- endfor -%}
    </div>

    {%- comment -%} Resumo {%- endcomment -%}
    <aside class="order-page__summary">
      <h2>Resumo</h2>

      <div class="order-totals">
        <div class="order-totals__row">
          <span>Subtotal</span>
          <span>{{ order.subtotal_price | money }}</span>
        </div>

        {%- for discount in order.cart_level_discount_applications -%}
          <div class="order-totals__row">
            <span>Desconto ({{ discount.title }})</span>
            <span>− {{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}

        {%- for shipping in order.shipping_methods -%}
          <div class="order-totals__row">
            <span>Frete ({{ shipping.title }})</span>
            <span>{{ shipping.price | money }}</span>
          </div>
        {%- endfor -%}

        {%- if order.tax_price > 0 -%}
          <div class="order-totals__row">
            <span>Impostos</span>
            <span>{{ order.tax_price | money }}</span>
          </div>
        {%- endif -%}

        <div class="order-totals__row order-totals__row--total">
          <span>Total</span>
          <strong>{{ order.total_price | money }}</strong>
        </div>
      </div>

      {%- if order.shipping_address -%}
        <div class="order-block">
          <h3>Entregar em</h3>
          <p>{{ order.shipping_address | format_address }}</p>
        </div>
      {%- endif -%}

      {%- if order.billing_address -%}
        <div class="order-block">
          <h3>Cobrança</h3>
          <p>{{ order.billing_address | format_address }}</p>
        </div>
      {%- endif -%}
    </aside>
  </div>
</section>
