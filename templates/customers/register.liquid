<section class="page-width auth">
  <div class="auth__card">
    <header class="auth__head">
      <h1 class="auth__title">Criar uma conta</h1>
      <p class="auth__lead">Acompanhe pedidos, salve produtos e veja seus endereços.</p>
    </header>

    {% form 'create_customer', class: 'auth__fields' %}
      {{ form.errors | default_errors }}

      <div class="auth__row-2">
        <label class="auth__field">
          <span class="auth__label">Nome</span>
          <input type="text" name="customer[first_name]" autocomplete="given-name" required>
        </label>
        <label class="auth__field">
          <span class="auth__label">Sobrenome</span>
          <input type="text" name="customer[last_name]" autocomplete="family-name" required>
        </label>
      </div>

      <label class="auth__field">
        <span class="auth__label">E-mail</span>
        <input type="email" name="customer[email]" autocomplete="email" required>
      </label>

      <label class="auth__field">
        <span class="auth__label">Senha</span>
        <input type="password" name="customer[password]" autocomplete="new-password" minlength="5" required>
        <small class="auth__hint">Mínimo 5 caracteres.</small>
      </label>

      <button type="submit" class="btn btn--primary auth__submit">Criar conta</button>
    {% endform %}

    <p class="auth__alt">
      Já tem conta? <a href="{{ routes.account_login_url }}">Entrar</a>
    </p>
  </div>
</section>
