{%- liquid
  assign email = settings.contact_email_address | default: 'loja@grupoexercitodedeus.com.br'
  assign phone = settings.contact_phone_number | default: '(43) 9993-5389'
  assign phone_clean = phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', ''
  assign address = settings.contact_address | default: 'Rua Carmela Dutra 190, Jardim Morumbi, CEP 86036-360, Londrina/PR'
  assign hours = settings.contact_hours | default: 'Segunda a sexta, 9h às 18h'
  assign wa = settings.social_whatsapp | remove: '+' | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}

<section class="page-width section contact-page">
  <header class="contact-page__head">
    <h1>{{ page.title | default: 'Fale conosco' }}</h1>
    <p class="muted">Tire dúvidas, peça orçamentos ou apenas mande um oi. Respondemos em até 1 dia útil.</p>
  </header>

  {%- if page.content != blank -%}
    <div class="rte" style="margin-bottom: 24px;">{{ page.content }}</div>
  {%- endif -%}

  <div class="contact-page__grid">
    {%- comment -%} Coluna esquerda: informações de contato {%- endcomment -%}
    <aside class="contact-info">
      <h2 class="contact-info__heading">Outros canais</h2>

      <ul class="contact-info__list" role="list">
        {%- if wa != blank -%}
          <li>
            <a href="https://wa.me/{{ wa }}?text=Ol%C3%A1!%20Tenho%20interesse%20nos%20produtos%20da%20loja." target="_blank" rel="noopener" class="contact-info__row contact-info__row--wa">
              <span class="contact-info__icon">{% render 'icon-whatsapp' %}</span>
              <span class="contact-info__main">
                <strong>WhatsApp</strong>
                <span>{{ phone }}</span>
              </span>
            </a>
          </li>
        {%- endif -%}

        {%- if phone != blank -%}
          <li>
            <a href="tel:{{ phone_clean }}" class="contact-info__row">
              <span class="contact-info__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <span class="contact-info__main">
                <strong>Telefone</strong>
                <span>{{ phone }}</span>
              </span>
            </a>
          </li>
        {%- endif -%}

        {%- if email != blank -%}
          <li>
            <a href="mailto:{{ email }}" class="contact-info__row">
              <span class="contact-info__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
              </span>
              <span class="contact-info__main">
                <strong>E-mail</strong>
                <span>{{ email }}</span>
              </span>
            </a>
          </li>
        {%- endif -%}

        {%- if address != blank -%}
          <li>
            <div class="contact-info__row">
              <span class="contact-info__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </span>
              <span class="contact-info__main">
                <strong>Endereço</strong>
                <span>{{ address }}</span>
              </span>
            </div>
          </li>
        {%- endif -%}

        {%- if hours != blank -%}
          <li>
            <div class="contact-info__row">
              <span class="contact-info__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </span>
              <span class="contact-info__main">
                <strong>Atendimento</strong>
                <span>{{ hours }}</span>
              </span>
            </div>
          </li>
        {%- endif -%}
      </ul>

      {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_youtube != blank or settings.social_tiktok != blank -%}
        <div class="contact-info__social">
          <h3 class="contact-info__heading">Redes sociais</h3>
          <div class="contact-info__socials">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon-instagram' %}</a>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon-facebook' %}</a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon-tiktok' %}</a>
            {%- endif -%}
            {%- if settings.social_youtube != blank -%}
              <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon-youtube' %}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </aside>

    {%- comment -%} Coluna direita: formulário {%- endcomment -%}
    <div class="contact-form-wrap">
      <h2 class="contact-form-wrap__heading">Envie uma mensagem</h2>
      <p class="muted contact-form-wrap__lead">Preencha o formulário abaixo e te respondemos por e-mail.</p>

      {% form 'contact', class: 'contact-form' %}
        {%- if form.posted_successfully? -%}
          <div class="contact-form__success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 16 9"/></svg>
            <div>
              <strong>Mensagem enviada!</strong>
              <p>Obrigado por entrar em contato. Vamos responder o quanto antes.</p>
            </div>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="contact-form__error">
            <strong>Não foi possível enviar:</strong>
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="auth__row-2">
          <label class="auth__field">
            <span class="auth__label">Nome</span>
            <input type="text" name="contact[name]" autocomplete="name" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </label>
          <label class="auth__field">
            <span class="auth__label">Telefone</span>
            <input type="tel" name="contact[phone]" autocomplete="tel" placeholder="(00) 00000-0000" value="{% if form.phone %}{{ form.phone }}{% endif %}">
          </label>
        </div>

        <label class="auth__field">
          <span class="auth__label">E-mail</span>
          <input type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
        </label>

        <label class="auth__field">
          <span class="auth__label">Assunto</span>
          <select name="contact[subject]">
            <option value="Dúvida sobre produto">Dúvida sobre produto</option>
            <option value="Status do pedido">Status do pedido</option>
            <option value="Troca ou devolução">Troca ou devolução</option>
            <option value="Atacado / Revenda">Atacado / Revenda</option>
            <option value="Sugestão / Elogio">Sugestão / Elogio</option>
            <option value="Outro">Outro</option>
          </select>
        </label>

        <label class="auth__field">
          <span class="auth__label">Mensagem</span>
          <textarea name="contact[body]" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </label>

        <button type="submit" class="btn btn--primary auth__submit">Enviar mensagem</button>
        <p class="muted" style="font-size: 0.78rem; margin: 8px 0 0;">Ao enviar você concorda com nossa <a href="/policies/privacy-policy">política de privacidade</a>.</p>
      {% endform %}
    </div>
  </div>

  {%- if settings.contact_map_embed != blank -%}
    <div class="contact-page__map">
      {{ settings.contact_map_embed }}
    </div>
  {%- endif -%}
</section>

{%- comment -%} Schema.org ContactPage {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": {{ page.title | default: 'Contato' | json }},
  "url": "{{ shop.url }}{{ page.url }}"
}
</script>
