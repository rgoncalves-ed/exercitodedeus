<section class="escola-trilhas page-width">
  {%- if section.settings.heading != blank -%}
    <header class="escola-trilhas__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="escola-trilhas__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="escola-trilhas__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="escola-trilhas__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="escola-trilhas__grid" style="--cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- assign link = block.settings.link | default: '#' -%}
        <a href="{{ link }}" class="trilha-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <div class="trilha-card__media">
              <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            </div>
          {%- else -%}
            <div class="trilha-card__media trilha-card__media--empty" style="background: {{ block.settings.color | default: '#1F2D4A' }};">
              <span aria-hidden="true">{{ block.settings.title | slice: 0, 1 | upcase }}</span>
            </div>
          {%- endif -%}
          <div class="trilha-card__body">
            <h3 class="trilha-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="trilha-card__desc">{{ block.settings.description }}</p>
            {%- endif -%}
            <span class="trilha-card__cta">Conhecer →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Escola — Trilhas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno superior", "default": "Nossas" },
    { "type": "text", "id": "heading", "label": "Título da seção", "default": "Trilhas" },
    { "type": "textarea", "id": "intro", "label": "Texto introdutório" }
  ],
  "blocks": [
    {
      "type": "trilha",
      "name": "Trilha",
      "settings": [
        { "type": "text", "id": "title", "label": "Nome da trilha" },
        { "type": "textarea", "id": "description", "label": "Descrição curta" },
        { "type": "image_picker", "id": "image", "label": "Imagem (opcional)" },
        { "type": "color", "id": "color", "label": "Cor de fundo (se sem imagem)", "default": "#1F2D4A" },
        { "type": "url", "id": "link", "label": "Link de destino" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Escola — Trilhas",
      "blocks": [
        { "type": "trilha", "settings": { "title": "Mulheres de Rocha" } },
        { "type": "trilha", "settings": { "title": "Famílias Consagradas" } },
        { "type": "trilha", "settings": { "title": "Forjados na Graça" } }
      ]
    }
  ]
}
{% endschema %}
