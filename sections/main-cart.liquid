<section class="page-width cart-checkout">
  <div class="cart-checkout__breadcrumb">
    <span class="is-active">1. Carrinho</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    <span>2. Identificação</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    <span>3. Pagamento</span>
  </div>

  <div class="cart-checkout__heading-row">
    <h1 class="cart-checkout__heading">Meu carrinho</h1>
    <p class="muted">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}itens{% endif %}</p>
  </div>

  {% render 'free-shipping-bar' %}

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-checkout__grid">

      <!-- Coluna esquerda: itens + frete -->
      <div class="cart-checkout__items-col">
        <div class="cart-checkout__items">
          {%- for item in cart.items -%}
            <article class="cart-row" data-line-key="{{ item.key }}" data-line-index="{{ forloop.index }}">
              <a href="{{ item.url }}" class="cart-row__media">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">
                {%- endif -%}
              </a>

              <div class="cart-row__main">
                <div class="cart-row__head">
                  {%- if item.product.vendor != blank -%}
                    <span class="cart-row__vendor">{{ item.product.vendor }}</span>
                  {%- endif -%}
                  <a href="{{ item.url }}"><h3 class="cart-row__title">{{ item.product.title }}</h3></a>
                  {%- unless item.variant.title contains 'Default' -%}
                    <p class="cart-row__variant">{{ item.variant.title }}</p>
                  {%- endunless -%}
                </div>

                <div class="cart-row__controls">
                  <div class="cart-qty">
                    <button type="button" data-line-decrease aria-label="Diminuir">−</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line-qty>
                    <button type="button" data-line-increase aria-label="Aumentar">+</button>
                  </div>
                  <button type="button" class="cart-row__remove" data-line-remove>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"/></svg>
                    Remover
                  </button>
                </div>
              </div>

              <div class="cart-row__price">
                {%- if item.original_line_price != item.final_line_price -%}
                  <span class="cart-row__compare">{{ item.original_line_price | money }}</span>
                {%- endif -%}
                <span class="cart-row__final">{{ item.final_line_price | money }}</span>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <!-- Cálculo de frete -->
        <div class="cart-checkout__shipping">
          {% render 'shipping-calculator', heading: 'Calcular frete' %}
        </div>
      </div>

      <!-- Coluna direita: resumo do pedido -->
      <aside class="cart-checkout__summary">
        <h2 class="cart-checkout__sub-heading">Resumo do pedido</h2>

        <div class="cart-checkout__totals">
          <div class="cart-checkout__row">
            <span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}itens{% endif %})</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-checkout__row cart-checkout__row--discount">
              <span>Cupom <strong>{{ discount.title }}</strong></span>
              <span style="color: #16A34A;">− {{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          {%- if cart.total_discount > 0 and cart.cart_level_discount_applications.size == 0 -%}
            <div class="cart-checkout__row">
              <span>Descontos</span>
              <span style="color: #16A34A;">− {{ cart.total_discount | money }}</span>
            </div>
          {%- endif -%}
          <div class="cart-checkout__row" data-shipping-row hidden>
            <span>Frete a partir de</span>
            <strong data-cheapest-shipping>—</strong>
          </div>
          <div class="cart-checkout__row muted" style="font-size: 0.85rem;" data-shipping-fallback>
            <span>Frete</span>
            <span>Calcule abaixo ou no checkout</span>
          </div>
          <div class="cart-checkout__row cart-checkout__row--total">
            <span>Total</span>
            <div style="text-align: right;">
              <strong>{{ cart.total_price | money }}</strong>
              <div class="muted" style="font-size: 0.78rem; font-weight: 400;">ou em até 12x de {{ cart.total_price | divided_by: 12 | money }}</div>
            </div>
          </div>
        </div>

        <!-- Cupom -->
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <div class="cart-checkout__coupon-applied">
            {%- for d in cart.cart_level_discount_applications -%}
              <div class="cart-checkout__coupon-tag">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Cupom <strong>{{ d.title }}</strong> aplicado</span>
              </div>
            {%- endfor -%}
            <p class="muted" style="font-size: 0.78rem; margin-top: 6px;">Para trocar ou remover, edite no checkout.</p>
          </div>
        {%- else -%}
          <details class="cart-checkout__coupon" data-coupon-form-wrap>
            <summary>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 0-.9-3.8 8.5 8.5 0 0 0-7.6-4.7 8.38 8.38 0 0 0-3.8.9L3 5l3 3-1 3 2.8 1.7-1.6 1.6L8 16l3-1 3 3 1.9-5.7"/></svg>
              <span>Tenho um cupom de desconto</span>
            </summary>
            <form class="cart-checkout__coupon-form" data-coupon-form>
              <input type="text"
                     name="discount"
                     placeholder="Código do cupom"
                     autocapitalize="characters"
                     autocomplete="off"
                     data-coupon-input>
              <button type="submit" class="btn btn--outline">Aplicar</button>
            </form>
            <p class="cart-checkout__coupon-msg" data-coupon-msg></p>
          </details>
        {%- endif -%}

        <!-- Botões -->
        <button type="submit" name="checkout" class="btn cart-checkout__finalize">
          Ir para o pagamento
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <a href="{{ routes.all_products_collection_url }}" class="cart-checkout__continue">Continuar comprando</a>

        <!-- Selos de segurança / pagamento -->
        <div class="cart-checkout__trust">
          <div class="cart-checkout__trust-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Pagamento 100% seguro</span>
          </div>
          <div class="cart-checkout__trust-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>Frete para todo o Brasil</span>
          </div>
          <div class="cart-checkout__trust-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M16 12l-4-4-4 4"/><path d="M12 16V8"/></svg>
            <span>Trocas e devoluções em até 30 dias</span>
          </div>
          <div class="cart-checkout__payments">
            <span class="payment-icon">VISA</span>
            <span class="payment-icon">MASTER</span>
            <span class="payment-icon">ELO</span>
            <span class="payment-icon">AMEX</span>
            <span class="payment-icon">PIX</span>
            <span class="payment-icon">BOLETO</span>
          </div>
        </div>
      </aside>
    </form>
  {%- else -%}
    <div class="cart-checkout__empty">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width: 64px; height: 64px; color: var(--color-text-muted);"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
      <h2>Seu carrinho está vazio</h2>
      <p class="muted">Que tal explorar nosso acervo e encontrar a próxima leitura?</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--lg">Ver todos os livros</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Carrinho",
  "settings": []
}
{% endschema %}
