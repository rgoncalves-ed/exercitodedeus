{%- assign autoplay = section.settings.autoplay_seconds | default: 7 -%}
{%- assign slide_count = section.blocks.size -%}

{%- if slide_count > 0 -%}
  <section class="section">
    <div class="page-width">
      <div class="cta-slider {% if slide_count > 1 %}cta-slider--multi{% endif %}"
           data-hero-slider
           data-autoplay="{{ autoplay }}"
           aria-roledescription="carousel">
        <div class="cta-slider__viewport">
          <div class="cta-slider__track" data-slider-track>
            {%- for block in section.blocks -%}
              <div class="cta-banner {% if block.settings.image == blank %}cta-banner--center{% endif %}"
                   data-slide
                   aria-roledescription="slide"
                   aria-label="Slide {{ forloop.index }} de {{ slide_count }}"
                   {% if forloop.index0 != 0 %}aria-hidden="true"{% endif %}
                   style="--cta-bg: {{ block.settings.background_color }}; --cta-text: {{ block.settings.text_color }};"
                   {{ block.shopify_attributes }}>
                <div class="cta-banner__content">
                  {%- if block.settings.eyebrow != blank -%}
                    <span class="hero-slide__eyebrow" style="opacity:0.7;">{{ block.settings.eyebrow }}</span>
                  {%- endif -%}
                  <h2 class="cta-banner__title">{{ block.settings.heading }}</h2>
                  {%- if block.settings.text != blank -%}
                    <p class="cta-banner__text">{{ block.settings.text }}</p>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <a href="{{ block.settings.button_url | default: '#' }}" class="btn btn--lg"
                       style="background: {{ block.settings.button_bg }}; color: {{ block.settings.button_color }};">
                      {{ block.settings.button_label }}
                    </a>
                  {%- endif -%}
                </div>
                {%- if block.settings.image -%}
                  <div class="cta-banner__image">
                    {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.heading }}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          {%- if slide_count > 1 -%}
            <button type="button" class="hero-slider__arrow hero-slider__arrow--prev" data-slider-prev aria-label="Slide anterior">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="hero-slider__arrow hero-slider__arrow--next" data-slider-next aria-label="Próximo slide">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>

            <div class="hero-slider__dots cta-slider__dots" data-slider-dots role="tablist">
              {%- for block in section.blocks -%}
                <button type="button"
                        class="hero-slider__dot{% if forloop.index0 == 0 %} is-active{% endif %}"
                        data-slider-dot="{{ forloop.index0 }}"
                        role="tab"
                        aria-label="Ir para slide {{ forloop.index }}"
                        aria-selected="{% if forloop.index0 == 0 %}true{% else %}false{% endif %}"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Banner CTA rotativo",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Tempo de troca automática (segundos)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 7
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide CTA",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem (opcional)" },
        { "type": "text", "id": "eyebrow", "label": "Texto pequeno" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Um combo para explicar a fé católica às crianças" },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "text", "id": "button_label", "label": "Botão", "default": "Garantir" },
        { "type": "url", "id": "button_url", "label": "Link" },
        { "type": "color", "id": "background_color", "label": "Cor de fundo", "default": "#DCE9F1" },
        { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#1A1A1A" },
        { "type": "color", "id": "button_bg", "label": "Cor do botão", "default": "#1F4E78" },
        { "type": "color", "id": "button_color", "label": "Cor do texto do botão", "default": "#FFFFFF" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Banner CTA rotativo",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Um combo para explicar a fé católica às crianças",
            "button_label": "Garantir",
            "background_color": "#DCE9F1"
          }
        }
      ]
    }
  ]
}
{% endschema %}
