{%- liquid
  assign show_message = section.settings.text
  assign show_phone = section.settings.contact_phone
  assign show_email = section.settings.contact_email
  assign show_social = false
  if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_youtube != blank or settings.social_whatsapp != blank or section.settings.mulheres_url != blank
    assign show_social = true
  endif
-%}

{%- if show_message != blank or show_phone != blank or show_email != blank or show_social -%}
  <div class="topbar" role="region" aria-label="Informações de contato e redes sociais"
       data-topbar
       style="--topbar-bg-1: {{ section.settings.bg_color_1 | default: '#564999' }};
              --topbar-bg-2: {{ section.settings.bg_color_2 | default: '#7ec0d5' }};
              --topbar-text: {{ section.settings.text_color | default: '#ffffff' }};">
    <div class="page-width topbar__inner">
      <div class="topbar__contacts">
        {%- if show_phone != blank -%}
          <a href="tel:{{ show_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="topbar__item">
            {% render 'icon-whatsapp' %}
            <span>{{ show_phone }}</span>
          </a>
        {%- endif -%}
        {%- if show_email != blank -%}
          <a href="mailto:{{ show_email }}" class="topbar__item topbar__item--email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
            <span>{{ show_email }}</span>
          </a>
        {%- endif -%}
        {%- if show_message != blank -%}
          <span class="topbar__message">{{ show_message }}</span>
        {%- endif -%}
      </div>

      <div class="topbar__actions">
        {%- if section.settings.show_cep_widget -%}
          <div class="topbar__cep" data-cep-widget>
            <button type="button" class="topbar__cep-trigger" data-cep-widget-toggle aria-expanded="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span class="topbar__cep-label">Entregar em</span>
              <strong class="topbar__cep-value" data-cep-widget-value>Definir CEP</strong>
            </button>
            <div class="topbar__cep-dropdown" data-cep-widget-dropdown hidden>
              <p class="topbar__cep-dropdown-title">Calcular entrega</p>
              <p class="topbar__cep-dropdown-info" data-cep-widget-info>Digite seu CEP pra estimar prazo e valor.</p>
              <div class="topbar__cep-form">
                <input type="text" placeholder="00000-000" inputmode="numeric" maxlength="9" data-cep-widget-input>
                <button type="button" class="btn btn--primary btn--sm" data-cep-widget-submit>OK</button>
              </div>
              <a href="https://buscacepinter.correios.com.br/" target="_blank" rel="noopener" class="topbar__cep-link">Não sei meu CEP</a>
              <div class="topbar__cep-result" data-cep-widget-result></div>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_track_order -%}
          {%- assign track_url = section.settings.track_order_url | default: routes.account_url -%}
          <a href="{{ track_url }}" class="topbar__action topbar__action--track">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 16h6"/><path d="M19 13v6"/><path d="M2 17a3 3 0 0 1 3-3h3.5a3 3 0 0 1 3 3v0a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3v0z"/><rect x="2" y="4" width="13" height="10" rx="2"/><circle cx="6" cy="9" r="0.5" fill="currentColor"/><circle cx="9" cy="9" r="0.5" fill="currentColor"/><circle cx="12" cy="9" r="0.5" fill="currentColor"/></svg>
            <span>{{ section.settings.track_order_label | default: 'Acompanhar pedido' }}</span>
          </a>
        {%- endif -%}

        {%- if show_social -%}
        <div class="topbar__social" aria-label="Redes sociais">
          {%- if section.settings.mulheres_url != blank -%}
            <a href="{{ section.settings.mulheres_url }}"
               target="_blank"
               rel="noopener"
               class="topbar__social-link topbar__social-link--mulheres"
               aria-label="Mulheres de Rocha"
               title="Mulheres de Rocha">
              {% render 'icon-diamond' %}
            </a>
          {%- endif -%}
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" class="topbar__social-link" aria-label="Instagram">
              {% render 'icon-instagram' %}
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" class="topbar__social-link" aria-label="Facebook">
              {% render 'icon-facebook' %}
            </a>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" class="topbar__social-link" aria-label="YouTube">
              {% render 'icon-youtube' %}
            </a>
          {%- endif -%}
          {%- if settings.social_whatsapp != blank -%}
            {%- assign wa_number = settings.social_whatsapp | remove: '+' | remove: ' ' | remove: '(' | remove: ')' | remove: '-' -%}
            <a href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener" class="topbar__social-link" aria-label="WhatsApp">
              {% render 'icon-whatsapp' %}
            </a>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra superior",
  "settings": [
    {
      "type": "header",
      "content": "Mensagem e contatos"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Mensagem (frete grátis, promoção etc)",
      "default": "Frete grátis acima de R$ 199 • Parcelamos em até 12x"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Telefone (exibe no topo)",
      "default": "(43) 9993-5389"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "E-mail (exibe no topo)",
      "default": "loja@grupoexercitodedeus.com.br"
    },
    {
      "type": "header",
      "content": "Widget CEP no topo"
    },
    {
      "type": "checkbox",
      "id": "show_cep_widget",
      "label": "Mostrar widget \"Entregar em\" no topo",
      "info": "Cliente pode definir o CEP em qualquer página; valor fica salvo e pre-preenche todas as calculadoras de frete.",
      "default": true
    },
    {
      "type": "header",
      "content": "Acompanhar pedido"
    },
    {
      "type": "checkbox",
      "id": "show_track_order",
      "label": "Mostrar botão \"Acompanhar pedido\" no topo",
      "default": true
    },
    {
      "type": "text",
      "id": "track_order_label",
      "label": "Texto do botão",
      "default": "Acompanhar pedido"
    },
    {
      "type": "url",
      "id": "track_order_url",
      "label": "Link (padrão: página da conta do cliente)"
    },
    {
      "type": "header",
      "content": "Link extra"
    },
    {
      "type": "url",
      "id": "mulheres_url",
      "label": "Link \"Mulheres de Rocha\" (ícone diamante)"
    },
    {
      "type": "header",
      "content": "Cores da barra"
    },
    {
      "type": "color",
      "id": "bg_color_1",
      "label": "Cor de fundo (gradient início)",
      "default": "#564999"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Cor de fundo (gradient fim)",
      "default": "#7ec0d5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
