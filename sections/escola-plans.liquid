            "installments": "12x R$ 42,90",
            "btn_label": "Quero esse plano",
            "disclaimer": "* Compra única, acesso por 12 meses."
          }
        },
        {
          "type": "plan",
          "settings": {
            "eyebrow": "Trilha",
            "name": "Famílias Consagradas",
            "tagline": "Para casais e famílias que querem caminhar juntos na fé.",
            "features": "Todos os cursos do Mulheres de Rocha\nTodos os cursos Forjados na Graça\nCursos exclusivos para famílias",
            "installments": "12x R$ 79,90",
            "highlight": true,
            "highlight_label": "Mais completo",
            "coming_soon": true,
            "launch_date": "19 de Agosto de 2026",
            "btn_label": "Garantir pré-venda",
            "disclaimer": "* Compra única, acesso por 12 meses."
          }
