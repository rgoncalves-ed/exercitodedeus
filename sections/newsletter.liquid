<section class="newsletter">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="seu@email.com" aria-label="E-mail" required>
      <button type="submit" class="btn btn--secondary">Inscrever-se</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Receba nossas novidades"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Lançamentos, promoções e conteúdo exclusivo direto no seu e-mail."
    }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
