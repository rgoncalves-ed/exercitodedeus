<header class="site-header" role="banner" data-site-header>
  <div class="page-width">
    <div class="site-header__inner">
      <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }} - página inicial">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 240 | image_tag: alt: shop.name, loading: 'eager' }}
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>

      {%- if section.settings.menu != blank -%}
        {%- assign menu_limit = section.settings.menu_max_items | default: 3 -%}
        <nav class="site-header__nav" aria-label="Menu principal">
          {%- for link in section.settings.menu.links limit: menu_limit -%}
            {%- if link.links.size > 0 -%}
              <div class="site-header__nav-item site-header__nav-item--has-children" data-dropdown>
                <a href="{{ link.url }}" class="site-header__nav-link" aria-haspopup="true" aria-expanded="false" data-dropdown-toggle>
                  {{ link.title }}
                  <svg class="site-header__nav-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </a>
                <div class="site-header__dropdown" role="menu" data-dropdown-panel>
                  <ul role="none">
                    {%- for sublink in link.links -%}
                      <li role="none">
                        <a href="{{ sublink.url }}" role="menuitem">{{ sublink.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="site-header__nav-link">{{ link.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" class="site-header__search" role="search" data-search-form>
        <input
          type="search"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
          aria-label="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          data-search-input>
        <input type="hidden" name="type" value="product">
        <button type="submit" aria-label="Buscar">{% render 'icon-search' %}</button>

        <div class="search-suggest" data-search-suggest hidden role="listbox" aria-label="Sugestões de busca">
          <div class="search-suggest__inner" data-search-suggest-inner></div>
        </div>
      </form>

      <div class="site-header__actions">
        <button type="button" class="header-action mobile-toggle" aria-label="Abrir menu" data-mobile-toggle aria-expanded="false">
          {% render 'icon-menu' %}
        </button>

        <a href="/pages/lista-de-desejo" class="header-action" aria-label="Lista de desejo">
          {% render 'icon-heart' %}
          <span class="header-action__count" data-wishlist-count hidden>0</span>
        </a>

        <button type="button" class="header-action" aria-label="Carrinho" data-cart-open>
          {% render 'icon-cart' %}
          <span class="header-action__count" data-cart-count>{{ cart.item_count }}</span>
        </button>

        {%- if shop.customer_accounts_enabled -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header-action header-action--btn">
            <span class="header-action__label">{% if customer %}Minha conta{% else %}Entrar{% endif %}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

{%- if section.settings.menu != blank -%}
  <div class="mobile-drawer" data-mobile-drawer hidden aria-hidden="true">
    <div class="mobile-drawer__backdrop" data-mobile-close></div>
    <aside class="mobile-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
      <header class="mobile-drawer__head">
        <span class="mobile-drawer__title">Menu</span>
        <button type="button" class="mobile-drawer__close" aria-label="Fechar menu" data-mobile-close>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </header>
      <nav class="mobile-drawer__nav" aria-label="Menu mobile">
        <ul role="list">
          {%- for link in section.settings.menu.links -%}
            <li class="mobile-drawer__item{% if link.links.size > 0 %} mobile-drawer__item--has-children{% endif %}">
              {%- if link.links.size > 0 -%}
                <details>
                  <summary>
                    <span>{{ link.title }}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                  </summary>
                  <ul role="list" class="mobile-drawer__sub">
                    <li><a href="{{ link.url }}">Ver tudo de {{ link.title }}</a></li>
                    {%- for sublink in link.links -%}
                      <li><a href="{{ sublink.url }}">{{ sublink.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </aside>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu inline (ao lado do logo)",
      "info": "Cada item pode ter um nível de submenu (Online Store → Navigation → adicionar sub-item).",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "menu_max_items",
      "label": "Máximo de itens no menu (desktop)",
      "info": "Os primeiros N itens aparecem no topo. O restante continua disponível no menu mobile completo.",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}
