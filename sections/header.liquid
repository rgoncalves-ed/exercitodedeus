<header class="site-header" role="banner">
  <div class="page-width">
    <div class="site-header__inner">
      <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }} - página inicial">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 240 | image_tag: alt: shop.name, loading: 'eager' }}
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>

      {%- if section.settings.menu != blank -%}
        {%- assign menu_limit = section.settings.menu_max_items | default: 3 -%}
        <nav class="site-header__nav" aria-label="Menu principal">
          {%- for link in section.settings.menu.links limit: menu_limit -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" class="site-header__search" role="search" data-search-form>
        <input
          type="search"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
          aria-label="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          data-search-input>
        <input type="hidden" name="type" value="product">
        <button type="submit" aria-label="Buscar">{% render 'icon-search' %}</button>

        <div class="search-suggest" data-search-suggest hidden role="listbox" aria-label="Sugestões de busca">
          <div class="search-suggest__inner" data-search-suggest-inner></div>
        </div>
      </form>

      <div class="site-header__actions">
        <button type="button" class="header-action mobile-toggle" aria-label="Abrir menu" data-mobile-toggle>
          {% render 'icon-menu' %}
        </button>

        <a href="/pages/lista-de-desejo" class="header-action" aria-label="Lista de desejo">
          {% render 'icon-heart' %}
          <span class="header-action__count" data-wishlist-count hidden>0</span>
        </a>

        <button type="button" class="header-action" aria-label="Carrinho" data-cart-open>
          {% render 'icon-cart' %}
          <span class="header-action__count" data-cart-count>{{ cart.item_count }}</span>
        </button>

        {%- if shop.customer_accounts_enabled -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header-action header-action--btn">
            <span class="header-action__label">{% if customer %}Minha conta{% else %}Entrar{% endif %}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu inline (ao lado do logo)",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "menu_max_items",
      "label": "Máximo de itens no menu",
      "info": "Os primeiros N itens do menu acima aparecem no topo. O restante vai pro menu mobile.",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}
