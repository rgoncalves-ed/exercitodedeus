<article class="article" itemscope itemtype="https://schema.org/Article">
  <header class="article__hero">
    <div class="page-width article__hero-inner">
      <a class="article__back" href="{{ blog.url }}">← {{ blog.title }}</a>
      {%- if article.tags.size > 0 -%}
        <div class="article__tags">
          {%- for tag in article.tags limit: 3 -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article__tag">{{ tag }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <h1 class="article__title" itemprop="headline">{{ article.title }}</h1>
      <div class="article__meta">
        {%- if article.author != blank -%}
          <span class="article__author">{{ article.author }}</span>
        {%- endif -%}
        <span class="article__date">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {{ article.published_at | date: "%d de %B de %Y" }}
        </span>
        {%- assign reading_words = article.content | strip_html | split: ' ' | size -%}
        {%- assign reading_minutes = reading_words | divided_by: 220 | at_least: 1 -%}
        <span class="article__reading">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {{ reading_minutes }} min de leitura
        </span>
      </div>
    </div>
    {%- if article.image -%}
      <div class="article__cover">
        <img src="{{ article.image | image_url: width: 1800 }}" alt="{{ article.image.alt | escape | default: article.title }}" itemprop="image" loading="eager">
      </div>
    {%- endif -%}
  </header>

  <div class="page-width article__layout">
    <aside class="article__aside" aria-label="Compartilhar">
      <span class="article__aside-label">Compartilhar</span>
      {%- assign url_full = shop.url | append: article.url -%}
      {%- assign share_title = article.title | url_encode -%}
      <a class="article__share-btn article__share-btn--wa" href="https://wa.me/?text={{ share_title }}%20{{ url_full | url_encode }}" target="_blank" rel="noopener" aria-label="WhatsApp">
        {% render 'icon-whatsapp' %}
      </a>
      <a class="article__share-btn article__share-btn--fb" href="https://www.facebook.com/sharer/sharer.php?u={{ url_full | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook">
        {% render 'icon-facebook' %}
      </a>
      <a class="article__share-btn article__share-btn--x" href="https://twitter.com/intent/tweet?text={{ share_title }}&url={{ url_full | url_encode }}" target="_blank" rel="noopener" aria-label="X / Twitter">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <button type="button" class="article__share-btn article__share-btn--copy" data-copy-link="{{ url_full }}" aria-label="Copiar link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      </button>
    </aside>

    <div class="article__body" itemprop="articleBody">
      {{ article.content }}
    </div>
  </div>

  {%- if section.settings.show_related -%}
    {%- assign related_articles = blog.articles -%}
    {%- assign related_count = 0 -%}
    <section class="page-width article-related">
      <h2 class="article-related__heading">{{ section.settings.related_heading | default: 'Leia também' }}</h2>
      <div class="blog-grid">
        {%- for other in related_articles -%}
          {%- if other.id != article.id and related_count < 3 -%}
            <a class="blog-card" href="{{ other.url }}">
              {%- if other.image -%}
                <div class="blog-card__media">
                  <img src="{{ other.image | image_url: width: 600 }}" alt="{{ other.image.alt | escape | default: other.title }}" loading="lazy">
                </div>
              {%- else -%}
                <div class="blog-card__media blog-card__media--empty">{% render 'icon-book' %}</div>
              {%- endif -%}
              <div class="blog-card__body">
                {%- if other.tags.size > 0 -%}<span class="blog-card__tag">{{ other.tags.first }}</span>{%- endif -%}
                <h3 class="blog-card__title">{{ other.title }}</h3>
                <div class="blog-card__meta">
                  <span>{{ other.published_at | date: "%d %b %Y" }}</span>
                </div>
              </div>
            </a>
            {%- assign related_count = related_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- if blog.comments_enabled? -%}
    <section class="page-width article-comments">
      <h2 class="article-comments__heading">Comentários ({{ article.comments_count }})</h2>

      {%- if article.comments_count > 0 -%}
        <ul class="article-comments__list" role="list">
          {%- for comment in article.comments -%}
            <li class="article-comment">
              <div class="article-comment__head">
                <strong>{{ comment.author }}</strong>
                <span>{{ comment.created_at | date: "%d %b %Y" }}</span>
              </div>
              <div class="article-comment__body">{{ comment.content }}</div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- form 'new_comment', article, class: 'article-comment-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="article-comment-form__success">✓ Obrigado pelo comentário! Ele aparecerá após moderação.</p>
        {%- elsif form.errors -%}
          <p class="article-comment-form__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="article-comment-form__row">
          <label>
            <span>Nome</span>
            <input type="text" name="comment[author]" required>
          </label>
          <label>
            <span>E-mail</span>
            <input type="email" name="comment[email]" required>
          </label>
        </div>
        <label class="article-comment-form__msg">
          <span>Comentário</span>
          <textarea name="comment[body]" rows="4" required></textarea>
        </label>
        <button type="submit" class="btn btn--primary">Enviar comentário</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Artigo",
  "settings": [
    { "type": "checkbox", "id": "show_related", "label": "Mostrar artigos relacionados", "default": true },
    { "type": "text", "id": "related_heading", "label": "Título da seção 'Leia também'", "default": "Leia também" }
  ]
}
{% endschema %}
