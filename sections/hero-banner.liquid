{%- assign autoplay = section.settings.autoplay_seconds | default: 6 -%}
{%- assign slide_count = section.blocks.size -%}

<section class="hero-slider {% if slide_count > 1 %}hero-slider--multi{% endif %}"
         data-hero-slider
         data-autoplay="{{ autoplay }}"
         aria-roledescription="carousel">
  <div class="page-width">
    <div class="hero-slider__viewport">
      <div class="hero-slider__track" data-slider-track>
        {%- for block in section.blocks -%}
          {%- assign is_empty = false -%}
          {%- if block.settings.image == blank -%}{%- assign is_empty = true -%}{%- endif -%}

          <a href="{{ block.settings.button_url | default: '#' }}"
             class="hero-slide{% if is_empty %} hero-slide--empty{% endif %}"
             style="{% unless is_empty %}background-color: {{ block.settings.background_color }};{% endunless %} color: {{ block.settings.text_color }};"
             data-slide
             aria-roledescription="slide"
             aria-label="Slide {{ forloop.index }} de {{ slide_count }}"
             {% if forloop.index0 != 0 %}aria-hidden="true"{% endif %}
             {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <span class="hero-slide__bg" style="background-image: url('{{ block.settings.image | image_url: width: 1800 }}')"></span>
            {%- endif -%}
            <div class="hero-slide__inner">
              {%- if block.settings.eyebrow != blank -%}
                <span class="hero-slide__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="hero-slide__title" style="color: {{ block.settings.text_color }};">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="hero-slide__text" style="color: {{ block.settings.text_color }};">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <span class="hero-slide__btn" style="background: {{ block.settings.button_bg }}; color: {{ block.settings.button_color }};">{{ block.settings.button_label }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if slide_count > 1 -%}
        <button type="button" class="hero-slider__arrow hero-slider__arrow--prev" data-slider-prev aria-label="Slide anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button type="button" class="hero-slider__arrow hero-slider__arrow--next" data-slider-next aria-label="Próximo slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </button>

        <div class="hero-slider__dots" data-slider-dots role="tablist">
          {%- for block in section.blocks -%}
            <button type="button"
                    class="hero-slider__dot{% if forloop.index0 == 0 %} is-active{% endif %}"
                    data-slider-dot="{{ forloop.index0 }}"
                    role="tab"
                    aria-label="Ir para slide {{ forloop.index }}"
                    aria-selected="{% if forloop.index0 == 0 %}true{% else %}false{% endif %}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner rotativo (hero)",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Tempo de troca automática (segundos)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem de fundo" },
        { "type": "text", "id": "eyebrow", "label": "Texto pequeno superior" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Bem-vindo à loja" },
        { "type": "textarea", "id": "text", "label": "Descrição" },
        { "type": "text", "id": "button_label", "label": "Texto do botão" },
        { "type": "url", "id": "button_url", "label": "Link do botão" },
        { "type": "color", "id": "background_color", "label": "Cor de fundo (sem imagem)", "default": "#2A4234" },
        { "type": "color", "id": "text_color", "label": "Cor do texto", "default": "#FFFFFF" },
        { "type": "color", "id": "button_bg", "label": "Cor do botão", "default": "#1F4E78" },
        { "type": "color", "id": "button_color", "label": "Cor do texto do botão", "default": "#FFFFFF" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Banner rotativo",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Meditações para",
            "heading": "PENTECOSTES",
            "text": "Aprofunde sua fé com livros e devocionais selecionados.",
            "button_label": "Veja mais",
            "background_color": "#1F2D4A",
            "text_color": "#FFFFFF",
            "button_bg": "#FFFFFF",
            "button_color": "#1F2D4A"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Novidades",
            "heading": "FÉ EM FAMÍLIA",
            "text": "Conteúdos para você compartilhar com os seus.",
            "button_label": "Explorar",
            "background_color": "#7A2F2F",
            "text_color": "#FFFFFF",
            "button_bg": "#FFFFFF",
            "button_color": "#7A2F2F"
          }
        }
      ]
    }
  ]
}
{% endschema %}
