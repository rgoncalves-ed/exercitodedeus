<section class="categories">
  <div class="page-width">
    <div class="section-heading">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
    </div>

    <div class="categories__grid">
      {%- for block in section.blocks -%}
        {%- assign category_collection = collections[block.settings.collection] -%}
        <a href="{% if block.settings.collection != blank %}{{ category_collection.url }}{% else %}#{% endif %}" class="category-card" {{ block.shopify_attributes }}>
          <span class="category-card__image">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 200 | image_tag: alt: block.settings.title, loading: 'lazy' }}
            {%- elsif category_collection.image -%}
              {{ category_collection.image | image_url: width: 200 | image_tag: alt: block.settings.title, loading: 'lazy' }}
            {%- else -%}
              {% render 'icon-book' %}
            {%- endif -%}
          </span>
          <span class="category-card__title">{{ block.settings.title | default: category_collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorias em destaque",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeno",
      "default": "Navegue por"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Categorias"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "collection", "id": "collection", "label": "Coleção" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Categorias",
      "blocks": [
        { "type": "category", "settings": { "title": "Bíblias" } },
        { "type": "category", "settings": { "title": "Espiritualidade" } },
        { "type": "category", "settings": { "title": "Liturgia" } },
        { "type": "category", "settings": { "title": "Santos" } },
        { "type": "category", "settings": { "title": "Família" } },
        { "type": "category", "settings": { "title": "Infantil" } }
      ]
    }
  ]
}
{% endschema %}
