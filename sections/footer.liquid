<footer class="site-footer" role="contentinfo">
  <div class="page-width">
    <div class="site-footer__columns">
      {%- for block in section.blocks -%}
        <div class="site-footer__column" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'links' -%}
              <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
              {%- if block.settings.menu != blank -%}
                <ul class="site-footer__list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- when 'text' -%}
              <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
              <div class="site-footer__list">{{ block.settings.body }}</div>
            {%- when 'social' -%}
              <h3 class="site-footer__heading">{{ block.settings.heading }}</h3>
              <p>{{ block.settings.text }}</p>
              <div class="site-footer__social">
                {%- if settings.social_instagram != blank -%}
                  <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon-instagram' %}</a>
                {%- endif -%}
                {%- if settings.social_facebook != blank -%}
                  <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon-facebook' %}</a>
                {%- endif -%}
                {%- if settings.social_youtube != blank -%}
                  <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon-youtube' %}</a>
                {%- endif -%}
                {%- if settings.social_whatsapp != blank -%}
                  <a href="https://wa.me/{{ settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">{% render 'icon-whatsapp' %}</a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <div>
        © {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.tagline }}
      </div>
      <div class="site-footer__payments" aria-label="Formas de pagamento">
        <span class="payment-icon">VISA</span>
        <span class="payment-icon">MASTER</span>
        <span class="payment-icon">ELO</span>
        <span class="payment-icon">PIX</span>
        <span class="payment-icon">BOLETO</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Ad Maiorem Dei Gloriam"
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Coluna de links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Institucional"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Coluna de texto",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Sobre nós"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Conteúdo",
          "default": "<p>Levando boa literatura católica até você.</p>"
        }
      ]
    },
    {
      "type": "social",
      "name": "Redes sociais",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Siga-nos"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Acompanhe nossos lançamentos e devocionais."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "links" },
      { "type": "links" },
      { "type": "text" },
      { "type": "social" }
    ]
  }
}
{% endschema %}
