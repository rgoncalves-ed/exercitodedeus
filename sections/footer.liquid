{%- liquid
  assign address = section.settings.address
  assign email = section.settings.email
  assign phone = section.settings.phone
  assign phone_clean = phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', ''
  assign wa_number = settings.social_whatsapp | remove: '+' | remove: ' ' | remove: '(' | remove: ')' | remove: '-'

  assign ita_wa_raw = settings.ita_whatsapp
  assign ita_wa = ita_wa_raw | remove: '+' | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
  assign ana_label = section.settings.ana_label | default: 'Redes Ana'
  assign ita_label = section.settings.ita_label | default: 'Redes Ita'
  assign has_ita = false
  if settings.ita_instagram != blank or settings.ita_facebook != blank or ita_wa != blank or settings.ita_tiktok != blank or settings.ita_spotify != blank or settings.ita_youtube != blank or settings.ita_kwai != blank
    assign has_ita = true
  endif
-%}

<footer class="site-footer" role="contentinfo">
  <div class="page-width">
    {%- if settings.social_wa_channel != blank and section.settings.show_wa_channel_cta -%}
      <a class="site-footer__wa-channel" href="{{ settings.social_wa_channel }}" target="_blank" rel="noopener">
        <span class="site-footer__wa-channel-icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 0C7.2 0 0 7.2 0 16c0 2.8.7 5.6 2.1 8L.1 32l8.2-2.1c2.3 1.3 5 2 7.8 2 8.8 0 16-7.2 16-16S24.8 0 16 0zm7.3 19.2c-.4-.2-2.4-1.2-2.7-1.3-.4-.1-.6-.2-.9.2-.3.4-1 1.3-1.3 1.6-.2.3-.5.3-.9.1-2.4-1.2-3.9-2.1-5.5-4.8-.4-.7.4-.7 1.2-2.2.1-.3.1-.5 0-.7-.1-.2-.9-2.2-1.2-3-.3-.8-.7-.7-.9-.7h-.8c-.3 0-.7.1-1.1.5-.4.4-1.4 1.4-1.4 3.3 0 2 1.4 3.9 1.6 4.1.2.3 2.8 4.3 6.8 6 1 .4 1.7.6 2.3.8.9.3 1.8.3 2.5.2.7-.1 2.4-1 2.7-1.9.3-.9.3-1.7.2-1.9-.1-.2-.4-.3-.8-.5z"/></svg>
        </span>
        <span class="site-footer__wa-channel-text">
          <strong>{{ section.settings.wa_channel_title | default: 'Participe do nosso canal no WhatsApp' }}</strong>
          <small>{{ section.settings.wa_channel_sub | default: 'Receba reflexões, lançamentos e novidades direto no celular.' }}</small>
        </span>
        <span class="site-footer__wa-channel-btn">{{ section.settings.wa_channel_btn | default: 'Entrar no canal' }} →</span>
      </a>
    {%- endif -%}
    <div class="site-footer__top">

      {%- comment -%} 1. SOCIAL — Redes Ana + Redes Ita {%- endcomment -%}
      <div class="site-footer__col site-footer__col--social">
        <div class="site-footer__socials-group">
          <h4 class="site-footer__heading site-footer__socials-label">{{ ana_label }}</h4>
          <ul class="site-footer__socials" role="list" aria-label="{{ ana_label }}">
            {%- if settings.social_instagram != blank -%}
              <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram {{ ana_label }}">{% render 'icon-instagram' %}</a></li>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook {{ ana_label }}">{% render 'icon-facebook' %}</a></li>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok {{ ana_label }}">{% render 'icon-tiktok' %}</a></li>
            {%- endif -%}
            {%- if settings.social_kwai != blank -%}
              <li><a href="{{ settings.social_kwai }}" target="_blank" rel="noopener" aria-label="Kwai {{ ana_label }}">{% render 'icon-kwai' %}</a></li>
            {%- endif -%}
            {%- if settings.social_spotify != blank -%}
              <li><a href="{{ settings.social_spotify }}" target="_blank" rel="noopener" aria-label="Spotify {{ ana_label }}">{% render 'icon-spotify' %}</a></li>
            {%- endif -%}
            {%- if settings.social_whatsapp != blank -%}
              <li><a href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener" aria-label="WhatsApp {{ ana_label }}">{% render 'icon-whatsapp' %}</a></li>
            {%- endif -%}
            {%- if settings.social_youtube != blank -%}
              <li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube {{ ana_label }}">{% render 'icon-youtube' %}</a></li>
            {%- endif -%}
          </ul>
        </div>

        {%- if has_ita -%}
          <div class="site-footer__socials-group">
            <h4 class="site-footer__heading site-footer__socials-label">{{ ita_label }}</h4>
            <ul class="site-footer__socials" role="list" aria-label="{{ ita_label }}">
              {%- if settings.ita_instagram != blank -%}
                <li><a href="{{ settings.ita_instagram }}" target="_blank" rel="noopener" aria-label="Instagram {{ ita_label }}">{% render 'icon-instagram' %}</a></li>
              {%- endif -%}
              {%- if settings.ita_facebook != blank -%}
                <li><a href="{{ settings.ita_facebook }}" target="_blank" rel="noopener" aria-label="Facebook {{ ita_label }}">{% render 'icon-facebook' %}</a></li>
              {%- endif -%}
              {%- if settings.ita_tiktok != blank -%}
                <li><a href="{{ settings.ita_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok {{ ita_label }}">{% render 'icon-tiktok' %}</a></li>
              {%- endif -%}
              {%- if settings.ita_kwai != blank -%}
                <li><a href="{{ settings.ita_kwai }}" target="_blank" rel="noopener" aria-label="Kwai {{ ita_label }}">{% render 'icon-kwai' %}</a></li>
              {%- endif -%}
              {%- if settings.ita_spotify != blank -%}
                <li><a href="{{ settings.ita_spotify }}" target="_blank" rel="noopener" aria-label="Spotify {{ ita_label }}">{% render 'icon-spotify' %}</a></li>
              {%- endif -%}
              {%- if settings.ita_youtube != blank -%}
                <li><a href="{{ settings.ita_youtube }}" target="_blank" rel="noopener" aria-label="YouTube {{ ita_label }}">{% render 'icon-youtube' %}</a></li>
              {%- endif -%}
              {%- if ita_wa != blank -%}
                <li><a href="https://wa.me/{{ ita_wa }}" target="_blank" rel="noopener" aria-label="WhatsApp {{ ita_label }}">{% render 'icon-whatsapp' %}</a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.show_security -%}
          <div class="site-footer__security">
            <h4 class="site-footer__heading">{{ section.settings.security_heading | default: 'Segurança' }}</h4>
            {% render 'icon-security' %}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} 2. INSTITUCIONAL {%- endcomment -%}
      <div class="site-footer__col">
        <h4 class="site-footer__heading">{{ section.settings.col1_heading | default: 'Institucional' }}</h4>
        <ul class="site-footer__links" role="list">
          {%- if section.settings.col1_menu != blank -%}
            {%- for link in section.settings.col1_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/quem-somos">Quem somos?</a></li>
            <li><a href="/pages/fale-conosco">Fale conosco</a></li>
            <li><a href="/pages/nossas-lojas">Nossas Lojas</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} 3. INFORMAÇÕES {%- endcomment -%}
      <div class="site-footer__col">
        <h4 class="site-footer__heading">{{ section.settings.col2_heading | default: 'Informações' }}</h4>
        <ul class="site-footer__links" role="list">
          {%- if section.settings.col2_menu != blank -%}
            {%- for link in section.settings.col2_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/politica-de-troca">Política de troca</a></li>
            <li><a href="/pages/politica-de-privacidade">Política de privacidade</a></li>
            <li><a href="/pages/politica-de-entrega">Política de entrega</a></li>
            <li><a href="/pages/politicas-de-cookies">Política de cookies</a></li>
            <li><a href="/pages/termos-de-uso">Termos de uso</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} 4. MINHA CONTA {%- endcomment -%}
      <div class="site-footer__col">
        <h4 class="site-footer__heading">{{ section.settings.col3_heading | default: 'Minha conta' }}</h4>
        <ul class="site-footer__links" role="list">
          {%- if section.settings.col3_menu != blank -%}
            {%- for link in section.settings.col3_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.account_register_url }}">Cadastre-se</a></li>
            <li><a href="{{ routes.account_url }}">Minha conta</a></li>
            <li><a href="{{ routes.account_url }}#orders">Meus pedidos</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} 5. ATENDIMENTO + PAGAMENTO {%- endcomment -%}
      <div class="site-footer__col site-footer__col--atendimento">
        <h4 class="site-footer__heading">{{ section.settings.contact_heading | default: 'Atendimento' }}</h4>
        <ul class="site-footer__contact" role="list">
          {%- if phone != blank -%}
            <li>
              <a href="https://wa.me/{{ wa_number | default: phone_clean }}" class="site-footer__contact-row" target="_blank" rel="noopener">
                <span class="site-footer__contact-icon">{% render 'icon-whatsapp' %}</span>
                <span>{{ phone }}</span>
              </a>
            </li>
          {%- endif -%}
          {%- if email != blank -%}
            <li>
              <a href="mailto:{{ email }}" class="site-footer__contact-row">
                <span class="site-footer__contact-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
                </span>
                <span>{{ email }}</span>
              </a>
            </li>
          {%- endif -%}
          {%- if address != blank -%}
            <li>
              <div class="site-footer__contact-row">
                <span class="site-footer__contact-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <span>{{ address }}</span>
              </div>
            </li>
          {%- endif -%}
        </ul>

        <div class="site-footer__payments-inline">
          <h4 class="site-footer__heading site-footer__heading--small">{{ section.settings.payment_heading | default: 'Formas de pagamento' }}</h4>
          {% render 'payment-icons' %}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'text' -%}
          <div class="site-footer__col site-footer__col--text" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h4 class="site-footer__heading">{{ block.settings.heading }}</h4>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="site-footer__text">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="site-footer__bottom-wrap">
    <div class="page-width site-footer__bottom">
      {%- comment -%}
        Identificação da empresa. Vem de um campo só (legal_entity) em vez de
        nome + CNPJ separados, porque o texto é jurídico e precisa sair exatamente
        como registrado, incluindo a grafia sem acento da razão social.
      {%- endcomment -%}
      <div class="site-footer__legal">
        {%- if section.settings.legal_entity != blank -%}
          <span class="site-footer__entity">{{ section.settings.legal_entity }}</span>
        {%- endif -%}
        <span class="site-footer__rights">
          © {{ 'now' | date: '%Y' }} · Todos os direitos reservados
          {%- if section.settings.tagline != blank %} · {{ section.settings.tagline }}{% endif -%}
        </span>
      </div>

      {%- if section.settings.adora_logo != blank -%}
        <a class="site-footer__adora"
           href="{{ section.settings.adora_url }}"
           target="_blank"
           rel="noopener"
           aria-label="{{ section.settings.adora_label | default: 'O site que você Adora' }}">
          {%- if section.settings.adora_label != blank -%}
            <span class="site-footer__adora-label">{{ section.settings.adora_label }}</span>
          {%- endif -%}
          <img src="{{ section.settings.adora_logo }}" alt="Adora" class="site-footer__adora-logo" loading="lazy">
        </a>
      {%- endif -%}
    </div>
  </div>
</footer>

{%- comment -%} Botão flutuante de WhatsApp {%- endcomment -%}
{%- if section.settings.float_whatsapp and settings.social_whatsapp != blank -%}
  {%- assign wa_msg = section.settings.float_whatsapp_msg | default: 'Olá! Tenho interesse nos produtos da loja.' | url_encode -%}
  <a href="https://wa.me/{{ wa_number }}?text={{ wa_msg }}"
     class="floating-whatsapp"
     target="_blank"
     rel="noopener"
     aria-label="Fale conosco no WhatsApp">
    {% render 'icon-whatsapp' %}
    {%- if section.settings.float_whatsapp_label != blank -%}
      <span class="floating-whatsapp__label">{{ section.settings.float_whatsapp_label }}</span>
    {%- endif -%}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    { "type": "header", "content": "Canal do WhatsApp (CTA topo do footer)" },
    { "type": "checkbox", "id": "show_wa_channel_cta", "label": "Mostrar botão 'Participe do canal'", "default": true, "info": "Usa o link configurado em Theme settings → Redes sociais → Canal do WhatsApp." },
    { "type": "text", "id": "wa_channel_title", "label": "Título do CTA", "default": "Participe do nosso canal no WhatsApp" },
    { "type": "text", "id": "wa_channel_sub", "label": "Subtítulo", "default": "Receba reflexões, lançamentos e novidades direto no celular." },
    { "type": "text", "id": "wa_channel_btn", "label": "Texto do botão", "default": "Entrar no canal" },

    { "type": "header", "content": "Redes sociais — Ana" },
    { "type": "paragraph", "content": "Os links abaixo ficam em Theme settings → Redes sociais. Aqui você só escolhe o nome que aparece em cima dos ícones." },
    { "type": "text", "id": "ana_label", "label": "Texto do grupo (Ana)", "default": "Redes Ana" },

    { "type": "header", "content": "Redes sociais — Ita" },
    { "type": "paragraph", "content": "Os links do Ítalo ficam em Theme settings → Redes sociais → Redes do Ítalo. Aqui você só escolhe o título exibido." },
    { "type": "text", "id": "ita_label", "label": "Texto do grupo (Ita)", "default": "Redes Ita" },

    { "type": "header", "content": "Coluna Institucional" },
    { "type": "text", "id": "col1_heading", "label": "Título", "default": "Institucional" },
    { "type": "link_list", "id": "col1_menu", "label": "Menu (opcional)" },

    { "type": "header", "content": "Coluna Informações" },
    { "type": "text", "id": "col2_heading", "label": "Título", "default": "Informações" },
    { "type": "link_list", "id": "col2_menu", "label": "Menu (opcional)" },

    { "type": "header", "content": "Coluna Minha Conta" },
    { "type": "text", "id": "col3_heading", "label": "Título", "default": "Minha conta" },
    { "type": "link_list", "id": "col3_menu", "label": "Menu (opcional)" },

    { "type": "header", "content": "Coluna Atendimento" },
    { "type": "text", "id": "contact_heading", "label": "Título", "default": "Atendimento" },
    { "type": "text", "id": "phone", "label": "Telefone", "default": "(43) 9993-5389" },
    { "type": "text", "id": "email", "label": "E-mail", "default": "loja@grupoexercitodedeus.com.br" },
    { "type": "textarea", "id": "address", "label": "Endereço", "default": "Rua Carmela Dutra 190, Jardim Morumbi, CEP 86036-360, Londrina/PR" },

    { "type": "header", "content": "Formas de pagamento" },
    { "type": "text", "id": "payment_heading", "label": "Título", "default": "Formas de pagamento" },

    { "type": "header", "content": "Segurança" },
    { "type": "checkbox", "id": "show_security", "label": "Mostrar selo de segurança", "default": true },
    { "type": "text", "id": "security_heading", "label": "Título", "default": "Segurança" },

    { "type": "header", "content": "Rodapé inferior" },
    { "type": "textarea", "id": "legal_entity", "label": "Identificação da empresa", "default": "IMPACTO PRODUCOES E PROMOCOES DE EVENTOS LTDA · CNPJ 46.386.798/0002-33 · Rua Carmela Dutra, nº 190, 2º andar, Sala 02, Jardim Morumbi, Londrina/PR, CEP 86036-360", "info": "Razão social, CNPJ e endereço. Manter a grafia exata do registro, inclusive sem acento na razão social." },
    { "type": "text", "id": "tagline", "label": "Tagline (após \"Todos os direitos reservados\")" },
    { "type": "text", "id": "dev_credit", "label": "Crédito de desenvolvimento" },

    { "type": "header", "content": "Selo Adora (canto direito do rodapé)" },
    { "type": "text", "id": "adora_label", "label": "Frase ao lado do logo", "default": "O SITE QUE VOCÊ" },
    { "type": "text", "id": "adora_logo", "label": "URL do logo (PNG/SVG)", "default": "https://cdn.shopify.com/s/files/1/0818/6911/1551/files/logo-adora.png?v=1779971113" },
    { "type": "url", "id": "adora_url", "label": "Link", "info": "Cole a URL do Instagram da Adora (https://www.instagram.com/adora.comunicacao/)" },

    { "type": "header", "content": "Botão flutuante WhatsApp" },
    { "type": "checkbox", "id": "float_whatsapp", "label": "Ativar botão flutuante", "default": true, "info": "Usa o número configurado em \"Theme settings → Redes sociais\"." },
    { "type": "text", "id": "float_whatsapp_label", "label": "Texto ao lado (opcional)", "default": "Fale conosco" },
    { "type": "textarea", "id": "float_whatsapp_msg", "label": "Mensagem pré-preenchida", "default": "Olá! Tenho interesse nos produtos da loja." }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Coluna de texto extra",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título da coluna", "default": "Mais um link" },
        { "type": "richtext", "id": "body", "label": "Conteúdo (HTML básico)" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
