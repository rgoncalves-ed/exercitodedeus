<section class="page-width product-page">
  <div class="product" data-product-section data-product-handle="{{ product.handle }}">
    <div class="product__left">
    <div class="product__gallery {% if product.images.size <= 1 %}product__gallery--single{% endif %}" data-gallery>
      {%- if product.images.size > 1 -%}
        <div class="product__thumbs">
          {%- for image in product.images -%}
            <button type="button"
                    class="product__thumb {% if forloop.first %}is-active{% endif %}"
                    data-gallery-thumb="{{ forloop.index0 }}"
                    aria-label="Imagem {{ forloop.index }}">
              <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | escape }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="product__gallery-stage">
        {%- if product.images.size > 1 -%}
          <button type="button" class="product__gallery-arrow product__gallery-arrow--prev" data-gallery-prev aria-label="Imagem anterior">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button type="button" class="product__gallery-arrow product__gallery-arrow--next" data-gallery-next aria-label="Próxima imagem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        {%- endif -%}

        <div class="product__main-track" data-gallery-track>
          {%- if product.images.size > 0 -%}
            {%- for image in product.images -%}
              <button type="button"
                      class="product__main-slide"
                      data-gallery-slide="{{ forloop.index0 }}"
                      data-zoom-src="{{ image | image_url: width: 1600 }}"
                      aria-label="Ver imagem {{ forloop.index }} em tela cheia">
                <img src="{{ image | image_url: width: 800 }}"
                     alt="{{ image.alt | escape | default: product.title }}"
                     class="product__main-img"
                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              </button>
            {%- endfor -%}
          {%- else -%}
            <div class="product__main-slide">{{ 'product-1' | placeholder_svg_tag: 'product__placeholder' }}</div>
          {%- endif -%}
        </div>

        <span class="product__zoom-hint" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          Toque pra ampliar
        </span>
      </div>
    </div>

    {%- if section.settings.show_trust_badges -%}
      <ul class="product__trust" role="list">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span><strong>Compra segura</strong> SSL · Criptografada</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span><strong>Frete pra todo Brasil</strong> Frenet · PAC · SEDEX</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          <span><strong>Troca em 30 dias</strong> Garantia satisfação</span>
        </li>
        {%- if settings.social_whatsapp != blank -%}
          <li class="product__trust-wa">
            {% render 'icon-whatsapp' %}
            <span><strong>Atendimento WhatsApp</strong> Respondemos em 1h útil</span>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
    </div>

    <div class="product__info">
      <div class="product__top-row">
        {%- if product.vendor != blank -%}
          <p class="product__vendor">{{ product.vendor }}</p>
        {%- endif -%}
        <span class="product-card__icon-circle" aria-hidden="true">{% render 'icon-book' %}</span>
      </div>

      <h1 class="product__title">{{ product.title }}</h1>

      {%- if product.description != blank -%}
        <div class="product__short-description">{{ product.description | strip_html | truncatewords: 50, "" }}</div>
        {%- assign desc_words = product.description | strip_html | split: ' ' | size -%}
        {%- if desc_words > 50 -%}
          <a href="#product-full-description" class="product__read-more" data-product-read-more>Ler descrição completa ↓</a>
        {%- endif -%}
      {%- endif -%}

      <div class="product__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="price__compare">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="price__final">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          {%- assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
          <span class="price__discount">{{ discount_pct }}% off</span>
        {%- endif -%}
        <span class="price__installments">ou em até 12x de {{ product.price | divided_by: 12 | money }}</span>
      </div>

      {%- liquid
        assign variant = product.selected_or_first_available_variant
        assign low_threshold = settings.low_stock_threshold | default: 5
        assign show_low_stock = false
        if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= low_threshold
          assign show_low_stock = true
        endif

        assign preorder_tag = settings.preorder_tag | default: 'pre-venda'
        assign is_preorder = false
        if product.tags contains preorder_tag and product.available
          assign is_preorder = true
          assign preorder_eta = product.metafields.custom.previsao_envio.value | strip
          if preorder_eta == blank
            assign preorder_eta = settings.preorder_note_default | default: 'assim que o lote estiver disponível'
          endif
          assign preorder_prop = 'Envio ' | append: preorder_eta
          assign preorder_ship_note = 'Produto em pré-venda: o prazo do frete conta a partir do despacho, que ocorre ' | append: preorder_eta | append: '.'
        endif
      -%}

      {%- if is_preorder -%}
        <div class="product__preorder" role="status">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <div class="product__preorder-text">
            <strong>Produto em pré-venda</strong>
            <span>Você paga agora e garante o seu. Envio <strong>{{ preorder_eta }}</strong>. O prazo do frete conta a partir da data de envio.</span>
          </div>
        </div>
      {%- endif -%}

      {%- if show_low_stock -%}
        <div class="product__stock product__stock--low" role="status">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
          <span>
            {%- if variant.inventory_quantity == 1 -%}
              <strong>Último em estoque!</strong> Garante o seu agora.
            {%- else -%}
              <strong>Apenas {{ variant.inventory_quantity }} {% if variant.inventory_quantity == 1 %}unidade{% else %}unidades{% endif %}</strong> em estoque.
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}

      {%- comment -%} Countdown de oferta (se data_fim configurada via metafield) {%- endcomment -%}
      {%- assign offer_end = product.metafields.offer.ends_at -%}
      {%- if offer_end != blank -%}
        <div class="product__countdown" data-countdown data-end="{{ offer_end | date: '%Y-%m-%dT%H:%M:%S' }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Oferta termina em <strong data-countdown-text>—</strong></span>
        </div>
      {%- endif -%}

      {%- if variant.available -%}
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="product__form" data-product-form>
          {%- unless product.has_only_default_variant -%}
            <script type="application/json" data-product-variants>
              {{ product.variants | json }}
            </script>
          {%- endunless -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="product-option" data-option-index="{{ forloop.index0 }}">
                <div class="product-option__head">
                  <span class="product-option__name">{{ option.name }}</span>
                  <span class="product-option__selected" data-option-selected>{{ option.selected_value }}</span>
                </div>
                <div class="product-option__values" role="radiogroup" aria-label="{{ option.name | escape }}">
                  {%- for value in option.values -%}
                    {%- assign opt_id = 'opt-' | append: forloop.parentloop.index | append: '-' | append: forloop.index -%}
                    <input type="radio"
                           class="product-option__input"
                           id="{{ opt_id }}"
                           name="options[{{ option.name }}]"
                           value="{{ value | escape }}"
                           {% if option.selected_value == value %}checked{% endif %}>
                    <label class="product-option__pill" for="{{ opt_id }}">{{ value }}</label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div class="product__qty-row">
            <div class="product__qty">
              <label class="product__qty-label" for="ProductQty">Quantidade</label>
              <div class="product__qty-controls">
                <button type="button" data-qty-decrease aria-label="Diminuir">−</button>
                <input id="ProductQty" type="number" name="quantity" value="1" min="1" {% if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 %}max="{{ variant.inventory_quantity }}"{% endif %} data-qty-input>
                <button type="button" data-qty-increase aria-label="Aumentar">+</button>
              </div>
            </div>
          </div>

          <input type="hidden" name="id" value="{{ variant.id }}">
          {%- if is_preorder -%}
            <input type="hidden" name="properties[Pré-venda]" value="{{ preorder_prop | escape }}">
          {%- endif -%}

          <div class="product__cta-row">
            <button type="submit" class="btn btn--primary btn--pill product__buy">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              {% if is_preorder %}Reservar pré-venda{% else %}Comprar{% endif %}
            </button>
            <button type="button"
                    class="product__wishlist-btn"
                    data-wishlist-toggle="{{ product.handle }}"
                    aria-label="Adicionar à lista de desejo">
              {% render 'icon-heart' %}
            </button>
          </div>
        </form>
      {%- else -%}
        {%- comment -%} Esgotado: form "Avise-me quando voltar" {%- endcomment -%}
        <div class="product__restock" data-restock>
          <div class="product__restock-head">
            <h3>Produto esgotado</h3>
            <p>Deixe seu e-mail e te avisamos assim que voltar.</p>
          </div>
          {% form 'contact', class: 'product__restock-form', id: 'RestockForm' %}
            {%- if form.posted_successfully? -%}
              <p class="product__restock-success">✓ Obrigado! Vamos te avisar.</p>
            {%- else -%}
              <input type="hidden" name="contact[subject]" value="Restock — {{ product.title | escape }}">
              <input type="hidden" name="contact[body]" value="Cliente quer ser avisado quando voltar: {{ product.title }} ({{ shop.url }}{{ product.url }})">
              <input type="email" name="contact[email]" placeholder="seu@email.com" required>
              <button type="submit" class="btn btn--primary">Avise-me</button>
            {%- endif -%}
          {% endform %}
          <button type="button"
                  class="product__wishlist-btn product__wishlist-btn--full"
                  data-wishlist-toggle="{{ product.handle }}">
            {% render 'icon-heart' %}
            <span>Adicionar à lista de desejo</span>
          </button>
        </div>
      {%- endif -%}

      {% render 'shipping-calculator',
         variant_id: product.selected_or_first_available_variant.id,
         unique: product.id,
         preorder_note: preorder_ship_note %}

      {%- comment -%} Compartilhar com botões diretos {%- endcomment -%}
      {%- assign product_url = shop.url | append: product.url -%}
      {%- assign share_text = product.title | append: ' — ' | append: product.price | money | url_encode -%}
      <div class="product__share-row">
        <span class="product__share-label">Compartilhar:</span>
        <a href="https://wa.me/?text={{ share_text }}%20{{ product_url | url_encode }}" target="_blank" rel="noopener" class="product__share-btn product__share-btn--wa" aria-label="Compartilhar no WhatsApp">
          {% render 'icon-whatsapp' %}
        </a>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ product_url | url_encode }}" target="_blank" rel="noopener" class="product__share-btn product__share-btn--fb" aria-label="Compartilhar no Facebook">
          {% render 'icon-facebook' %}
        </a>
        <a href="https://pinterest.com/pin/create/button/?url={{ product_url | url_encode }}{% if product.featured_image %}&media={{ product.featured_image | image_url: width: 800 | url_encode }}{% endif %}&description={{ product.title | url_encode }}" target="_blank" rel="noopener" class="product__share-btn product__share-btn--pin" aria-label="Compartilhar no Pinterest">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0a12 12 0 0 0-4.4 23.2c-.1-.9-.2-2.4 0-3.4l1.4-6S8.7 13 8.7 11.7c0-2 1.2-3.5 2.6-3.5 1.3 0 1.9.9 1.9 2 0 1.3-.8 3.1-1.2 4.8-.3 1.5.8 2.7 2.2 2.7 2.7 0 4.7-2.8 4.7-6.9 0-3.6-2.6-6.1-6.3-6.1-4.3 0-6.9 3.2-6.9 6.6 0 1.3.5 2.7 1.1 3.5.2.2.2.3.1.5l-.4 1.7c-.1.3-.2.3-.5.2-1.7-.8-2.8-3.3-2.8-5.3 0-4.3 3.1-8.3 9-8.3 4.7 0 8.4 3.4 8.4 7.9 0 4.7-2.9 8.5-7 8.5-1.4 0-2.6-.7-3.1-1.6l-.8 3.2c-.3 1.1-1.1 2.6-1.6 3.5A12 12 0 1 0 12 0z"/></svg>
        </a>
        <button type="button" class="product__share-btn product__share-btn--copy" data-copy-link="{{ product_url }}" aria-label="Copiar link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
      </div>
    </div>

  </div>

  {%- comment -%} Sticky add-to-cart no mobile (aparece quando scrolla além do botão original) {%- endcomment -%}
  {%- if variant.available -%}
    <div class="product__sticky-cart" data-sticky-cart hidden aria-hidden="true">
      <div class="page-width product__sticky-cart-inner">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 120 }}" alt="" class="product__sticky-cart-img">
        {%- endif -%}
        <div class="product__sticky-cart-info">
          <span class="product__sticky-cart-title">{{ product.title | truncate: 50 }}</span>
          <span class="product__sticky-cart-price">{{ product.price | money }}</span>
        </div>
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-product-form class="product__sticky-cart-form">
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          {%- if is_preorder -%}
            <input type="hidden" name="properties[Pré-venda]" value="{{ preorder_prop | escape }}">
          {%- endif -%}
          <button type="submit" class="btn btn--primary btn--pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            {% if is_preorder %}Reservar{% else %}Comprar{% endif %}
          </button>
        </form>
      </div>
    </div>
  {%- endif -%}

  {%- if product.description != blank or product.metafields.specs.list != blank -%}
    <div class="product-details" id="product-full-description">
      <div class="product-details__column">
        <h2 class="product-details__heading">Sobre</h2>
        <div class="product-details__text">
          {{ product.description }}
        </div>
      </div>

      <div class="product-details__column">
        <h2 class="product-details__heading">Itens / Especificações</h2>
        <dl class="product-details__specs">
          <dt>Título:</dt><dd>{{ product.title }}</dd>
          {%- if product.vendor != blank -%}
            <dt>Editora:</dt><dd>{{ product.vendor }}</dd>
          {%- endif -%}
          {%- if product.type != blank -%}
            <dt>Tipo:</dt><dd>{{ product.type }}</dd>
          {%- endif -%}
        </dl>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}
    Compre junto (bundle) — só para produtos de variante única.
    O bundle adiciona ao carrinho a 1ª variante de cada item (sem seletor de
    tamanho), então só aparece quando o produto da página E os sugeridos não
    têm variações; assim nunca cai o tamanho errado.
  {%- endcomment -%}
  {%- comment -%} Pré-venda fica fora do bundle: o form do bundle adiciona via JS sem a etiqueta "Pré-venda", e misturar itens de envio imediato com pré-venda atrasaria o pedido todo. {%- endcomment -%}
  {%- if section.settings.show_bundle and product.has_only_default_variant and product.collections.size > 0 and is_preorder != true -%}
    {%- assign bundle_collection = product.collections.first -%}
    {%- assign bundle_others = '' | split: ',' -%}
    {%- for p in bundle_collection.products -%}
      {%- unless p.tags contains preorder_tag -%}
        {%- if p.id != product.id and p.available and p.has_only_default_variant and bundle_others.size < 2 -%}
          {%- assign bundle_others = bundle_others | concat: '' | push: p -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}

    {%- if bundle_others.size > 0 -%}
      <section class="bundle">
        <h2 class="section-heading__title bundle__heading">Comprado frequentemente junto</h2>

        <form class="bundle__form" data-bundle-form>
          <div class="bundle__items">
            {%- comment -%} Produto atual (sempre marcado, disabled) {%- endcomment -%}
            <label class="bundle__item bundle__item--current">
              <input type="checkbox" name="ids" value="{{ product.selected_or_first_available_variant.id }}" checked disabled data-bundle-item data-price="{{ product.price }}">
              <div class="bundle__item-media">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}">
                {%- endif -%}
              </div>
              <div class="bundle__item-info">
                <span class="bundle__item-tag">Este produto</span>
                <span class="bundle__item-title">{{ product.title | truncate: 50 }}</span>
                <span class="bundle__item-price">{{ product.price | money }}</span>
              </div>
            </label>

            {%- for other in bundle_others -%}
              <div class="bundle__plus" aria-hidden="true">+</div>
              <label class="bundle__item">
                <input type="checkbox" name="ids" value="{{ other.selected_or_first_available_variant.id }}" checked data-bundle-item data-price="{{ other.price }}">
                <div class="bundle__item-media">
                  {%- if other.featured_image -%}
                    <img src="{{ other.featured_image | image_url: width: 200 }}" alt="{{ other.title | escape }}">
                  {%- endif -%}
                </div>
                <div class="bundle__item-info">
                  <a href="{{ other.url }}" class="bundle__item-title">{{ other.title | truncate: 50 }}</a>
                  <span class="bundle__item-price">{{ other.price | money }}</span>
                </div>
              </label>
            {%- endfor -%}
          </div>

          <div class="bundle__summary">
            <div>
              <span class="bundle__total-label">Comprar selecionados:</span>
              <strong class="bundle__total" data-bundle-total>{{ product.price | money }}</strong>
            </div>
            <button type="submit" class="btn btn--primary bundle__submit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              <span data-bundle-btn-text>Comprar selecionados</span>
            </button>
          </div>
        </form>
      </section>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} Produtos relacionados {%- endcomment -%}
  {%- if section.settings.show_related and product.collections.size > 0 -%}
    {%- assign related_collection = product.collections.first -%}
    {%- assign related_count = 0 -%}
    {%- assign related_limit = 3 -%}

    <section class="related-products">
      <div class="section-heading section-heading--simple">
        <h2 class="section-heading__title">{{ section.settings.related_heading | default: 'Você também pode gostar' }}</h2>
        <a href="{{ related_collection.url }}" class="section-heading__link">Ver mais →</a>
      </div>

      <div class="product-grid product-grid--3 related-products__grid">
        {%- for related in related_collection.products -%}
          {%- if related.id != product.id and related_count < related_limit -%}
            {% render 'product-card', product: related %}
            {%- assign related_count = related_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} Visto recentemente {%- endcomment -%}
  {%- if section.settings.show_recently_viewed -%}
    <section class="recently-viewed" data-recently-viewed hidden>
      <div class="section-heading section-heading--simple">
        <h2 class="section-heading__title">{{ section.settings.recent_heading | default: 'Você viu recentemente' }}</h2>
      </div>
      <div class="product-grid product-grid--4" data-recently-viewed-list></div>
    </section>
  {%- endif -%}

  {%- comment -%} Lightbox da galeria {%- endcomment -%}
  <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Imagem em tela cheia">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Fechar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button type="button" class="lightbox__arrow lightbox__arrow--prev" data-lightbox-prev aria-label="Anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" class="lightbox__arrow lightbox__arrow--next" data-lightbox-next aria-label="Próxima">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <img class="lightbox__img" data-lightbox-img alt="">
    <span class="lightbox__counter" data-lightbox-counter></span>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="product-faq">
      <h2 class="product-faq__heading">Perguntas frequentes</h2>
      <div class="product-faq__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="product-faq__item" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="product-faq__answer">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Produto",
  "settings": [
    {
      "type": "header",
      "content": "Confiança"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Mostrar selos de confiança (compra segura, frete, troca, WhatsApp)",
      "default": true
    },
    {
      "type": "header",
      "content": "Compre junto"
    },
    {
      "type": "checkbox",
      "id": "show_bundle",
      "label": "Mostrar 'Comprado frequentemente junto'",
      "default": true,
      "info": "Mostra 2 produtos da mesma coleção como combo. Cliente pode desmarcar."
    },
    {
      "type": "header",
      "content": "Visto recentemente"
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed",
      "label": "Mostrar 'Você viu recentemente'",
      "default": true
    },
    {
      "type": "text",
      "id": "recent_heading",
      "label": "Título",
      "default": "Você viu recentemente"
    },
    {
      "type": "header",
      "content": "Produtos relacionados"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Mostrar produtos relacionados no final da página",
      "default": true
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Título",
      "default": "Você também pode gostar"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pergunta frequente",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta" },
        { "type": "richtext", "id": "answer", "label": "Resposta" }
      ]
    }
  ],
  "max_blocks": 10
}
{% endschema %}
