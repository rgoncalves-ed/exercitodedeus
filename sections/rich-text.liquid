<section class="section">
  <div class="page-width" style="max-width: 760px; text-align: center;">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div {{ block.shopify_attributes }} class="muted">{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <p {{ block.shopify_attributes }} style="margin-top: 24px;">
            <a href="{{ block.settings.button_url }}" class="btn btn--primary">{{ block.settings.button_label }}</a>
          </p>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto destacado",
  "settings": [],
  "blocks": [
    {
      "type": "heading",
      "name": "Título",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Nossa missão"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Levamos boa literatura católica e cristã para fortalecer sua fé e da sua família.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Botão",
      "settings": [
        { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Conheça nossa história" },
        { "type": "url", "id": "button_url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Texto destacado",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
