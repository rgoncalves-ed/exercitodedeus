{%- comment -%}
  Mostra os selos das formas de pagamento REAIS habilitadas na loja.
  Fonte: shop.enabled_payment_types (Shopify Payments / Stripe etc).
  Pix e Boleto sao adicionados se ativados via theme settings,
  porque normalmente vem via apps externos (PagarMe, MercadoPago)
  e nao aparecem em enabled_payment_types.
{%- endcomment -%}

{%- assign types = shop.enabled_payment_types -%}

{%- if types.size > 0 or settings.payment_show_pix or settings.payment_show_boleto -%}
  <ul class="payment-grid" role="list" aria-label="Formas de pagamento aceitas">
    {%- for type in types -%}
      {% render 'payment-icon', type: type %}
    {%- endfor -%}

    {%- if settings.payment_show_pix -%}
      {% render 'payment-icon', type: 'pix' %}
    {%- endif -%}

    {%- if settings.payment_show_boleto -%}
      {% render 'payment-icon', type: 'boleto' %}
    {%- endif -%}
  </ul>
{%- else -%}
  <p class="muted" style="font-size:0.78rem;">Configure as formas de pagamento em <em>Admin → Configurações → Pagamentos</em>.</p>
{%- endif -%}
