{%- comment -%}
  Selos de pagamento — SVGs limpos, cores próximas das marcas.
{%- endcomment -%}

<ul class="payment-grid" role="list" aria-label="Formas de pagamento aceitas">
  <li class="payment-badge" aria-label="Visa">
    <svg viewBox="0 0 56 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="56" height="36" rx="5" fill="#1A1F71"/>
      <text x="28" y="24" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-style="italic" font-weight="900" font-size="14" fill="#fff" letter-spacing="0.4">VISA</text>
    </svg>
  </li>

  <li class="payment-badge" aria-label="Mastercard">
    <svg viewBox="0 0 56 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="56" height="36" rx="5" fill="#fff" stroke="#E5E5E5"/>
      <circle cx="22" cy="18" r="9" fill="#EB001B"/>
      <circle cx="34" cy="18" r="9" fill="#F79E1B"/>
      <path d="M28 11a9 9 0 0 0 0 14 9 9 0 0 0 0-14z" fill="#FF5F00"/>
    </svg>
  </li>

  <li class="payment-badge" aria-label="Elo">
    <svg viewBox="0 0 56 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="56" height="36" rx="5" fill="#000"/>
      <circle cx="20" cy="18" r="5" fill="#FFD400"/>
      <circle cx="28" cy="18" r="5" fill="#EB1126"/>
      <circle cx="36" cy="18" r="5" fill="#00A4E0"/>
    </svg>
  </li>

  <li class="payment-badge" aria-label="Hipercard">
    <svg viewBox="0 0 56 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="56" height="36" rx="5" fill="#B3131B"/>
      <text x="28" y="23" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="9" fill="#fff" letter-spacing="0.4">HIPER</text>
    </svg>
  </li>

  <li class="payment-badge" aria-label="American Express">
    <svg viewBox="0 0 56 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="56" height="36" rx="5" fill="#2E77BC"/>
      <text x="28" y="23" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="10" fill="#fff" letter-spacing="0.6">AMEX</text>
    </svg>
  </li>

  <li class="payment-badge" aria-label="Diners">
    <svg viewBox="0 0 56 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="56" height="36" rx="5" fill="#fff" stroke="#E5E5E5"/>
      <circle cx="28" cy="18" r="10" fill="#0079BE"/>
      <path d="M24 11a8 8 0 0 0 0 14V11z" fill="#fff"/>
      <path d="M32 11a8 8 0 0 1 0 14V11z" fill="#fff"/>
    </svg>
  </li>

  <li class="payment-badge" aria-label="Pix">
    <svg viewBox="0 0 56 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="56" height="36" rx="5" fill="#fff" stroke="#E5E5E5"/>
      <g transform="translate(16 8) scale(0.83)">
        <path d="M11.3 17a3.2 3.2 0 0 1-2.3-1L5.7 12.8l-2 2A3.5 3.5 0 0 1 1.4 16H1l4.3 4.3a4.4 4.4 0 0 0 6.2 0L15.8 16h-.8a3.5 3.5 0 0 1-2.3-1l-2-2-3.2 3.3a3.2 3.2 0 0 1 3.8.7z" fill="#32BCAD"/>
        <path d="M11.3 7a3.2 3.2 0 0 0-2.3 1L5.7 11.2l-2-2A3.5 3.5 0 0 0 1.4 8H1l4.3-4.3a4.4 4.4 0 0 1 6.2 0L15.8 8h-.8a3.5 3.5 0 0 0-2.3 1l-2 2-3.2-3.3a3.2 3.2 0 0 0 3.8-.7z" fill="#32BCAD"/>
      </g>
      <text x="42" y="23" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="10" fill="#32BCAD" letter-spacing="0.2">pix</text>
    </svg>
  </li>

  <li class="payment-badge" aria-label="Boleto bancário">
    <svg viewBox="0 0 56 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="56" height="36" rx="5" fill="#fff" stroke="#E5E5E5"/>
      <g fill="#1A1A1A">
        <rect x="8"  y="8" width="1.5" height="20"/>
        <rect x="11" y="8" width="2.5" height="20"/>
        <rect x="15" y="8" width="1"   height="20"/>
        <rect x="17" y="8" width="3"   height="20"/>
        <rect x="22" y="8" width="1.5" height="20"/>
        <rect x="25" y="8" width="2"   height="20"/>
        <rect x="29" y="8" width="1"   height="20"/>
        <rect x="31" y="8" width="3"   height="20"/>
        <rect x="36" y="8" width="1.5" height="20"/>
        <rect x="39" y="8" width="2.5" height="20"/>
        <rect x="43" y="8" width="1"   height="20"/>
        <rect x="45" y="8" width="3"   height="20"/>
      </g>
    </svg>
  </li>
</ul>
