{%- comment -%}
  Conjunto de selos de pagamento. Cores próprias e aproximadas das marcas.
{%- endcomment -%}

<ul class="payment-grid" role="list" aria-label="Formas de pagamento aceitas">
  <li class="payment-badge payment-badge--visa" aria-label="Visa">
    <svg viewBox="0 0 48 30" aria-hidden="true">
      <rect width="48" height="30" rx="3" fill="#1A1F71"/>
      <text x="24" y="20" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="11" fill="#fff" letter-spacing="0.5">VISA</text>
    </svg>
  </li>
  <li class="payment-badge payment-badge--master" aria-label="Mastercard">
    <svg viewBox="0 0 48 30" aria-hidden="true">
      <rect width="48" height="30" rx="3" fill="#fff"/>
      <circle cx="20" cy="15" r="8" fill="#EB001B"/>
      <circle cx="28" cy="15" r="8" fill="#F79E1B" opacity="0.92"/>
      <path d="M24 9.5a8 8 0 0 0 0 11" stroke="#FF5F00" stroke-width="0.3" fill="none"/>
    </svg>
  </li>
  <li class="payment-badge payment-badge--elo" aria-label="Elo">
    <svg viewBox="0 0 48 30" aria-hidden="true">
      <rect width="48" height="30" rx="3" fill="#000"/>
      <circle cx="18" cy="15" r="3.5" fill="#FFD400"/>
      <circle cx="24" cy="15" r="3.5" fill="#EB1126"/>
      <circle cx="30" cy="15" r="3.5" fill="#00A4E0"/>
    </svg>
  </li>
  <li class="payment-badge payment-badge--hiper" aria-label="Hipercard">
    <svg viewBox="0 0 48 30" aria-hidden="true">
      <rect width="48" height="30" rx="3" fill="#B3131B"/>
      <text x="24" y="19" text-anchor="middle" font-family="Arial, sans-serif" font-weight="800" font-size="8" fill="#fff" letter-spacing="0.3">HIPER</text>
    </svg>
  </li>
  <li class="payment-badge payment-badge--amex" aria-label="American Express">
    <svg viewBox="0 0 48 30" aria-hidden="true">
      <rect width="48" height="30" rx="3" fill="#2E77BC"/>
      <text x="24" y="20" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="9" fill="#fff" letter-spacing="0.5">AMEX</text>
    </svg>
  </li>
  <li class="payment-badge payment-badge--diners" aria-label="Diners">
    <svg viewBox="0 0 48 30" aria-hidden="true">
      <rect width="48" height="30" rx="3" fill="#0079BE"/>
      <circle cx="20" cy="15" r="7" fill="#fff"/>
      <circle cx="28" cy="15" r="7" fill="#fff"/>
      <circle cx="24" cy="15" r="5" fill="#0079BE"/>
    </svg>
  </li>
  <li class="payment-badge payment-badge--pix" aria-label="Pix">
    <svg viewBox="0 0 48 30" aria-hidden="true">
      <rect width="48" height="30" rx="3" fill="#fff" stroke="#E5E5E5"/>
      <text x="24" y="19" text-anchor="middle" font-family="Arial, sans-serif" font-weight="900" font-size="10" fill="#32BCAD" letter-spacing="0.5">pix</text>
    </svg>
  </li>
  <li class="payment-badge payment-badge--boleto" aria-label="Boleto bancário">
    <svg viewBox="0 0 48 30" aria-hidden="true">
      <rect width="48" height="30" rx="3" fill="#fff" stroke="#E5E5E5"/>
      <g fill="#1A1A1A">
        <rect x="8"  y="8" width="1" height="14"/>
        <rect x="10" y="8" width="2" height="14"/>
        <rect x="13" y="8" width="1" height="14"/>
        <rect x="15" y="8" width="3" height="14"/>
        <rect x="19" y="8" width="1" height="14"/>
        <rect x="21" y="8" width="2" height="14"/>
        <rect x="24" y="8" width="1" height="14"/>
        <rect x="26" y="8" width="3" height="14"/>
        <rect x="30" y="8" width="1" height="14"/>
        <rect x="32" y="8" width="2" height="14"/>
        <rect x="35" y="8" width="1" height="14"/>
        <rect x="37" y="8" width="3" height="14"/>
      </g>
    </svg>
  </li>
</ul>
