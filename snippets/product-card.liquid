{%- liquid
  assign card_ratio = settings.card_image_ratio | default: 'portrait'
  assign on_sale = false
  assign discount_pct = 0
  if product.compare_at_price > product.price
    assign on_sale = true
    assign discount_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif

  assign is_new = false
  assign new_days = settings.badge_new_days | default: 30
  if product.created_at and new_days > 0
    assign days_old = 'now' | date: '%s' | minus: product.created_at | date: '%s' | divided_by: 86400
    if days_old <= new_days
      assign is_new = true
    endif
  endif

  assign is_bestseller = false
  assign bestseller_tag = settings.badge_bestseller_tag | default: 'mais-vendido'
  if product.tags contains bestseller_tag
    assign is_bestseller = true
  endif

  assign is_soldout = false
  unless product.available
    assign is_soldout = true
  endunless

  assign first_variant = product.selected_or_first_available_variant
  assign low_threshold = settings.low_stock_threshold | default: 5
  assign low_stock_qty = 0
  if first_variant.inventory_management == 'shopify' and first_variant.inventory_policy == 'deny' and first_variant.inventory_quantity > 0 and first_variant.inventory_quantity <= low_threshold
    assign low_stock_qty = first_variant.inventory_quantity
  endif
-%}

<div class="product-card" data-product-handle="{{ product.handle }}">
  <a href="{{ product.url }}" class="product-card__media product-card__media--{{ card_ratio }}">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 500 }}"
           alt="{{ product.featured_image.alt | default: product.title | escape }}"
           loading="lazy"
           width="500"
           height="{{ 500 | divided_by: product.featured_image.aspect_ratio | round }}">
    {%- endif -%}
  </a>

  <div class="product-card__badges">
    {%- if is_soldout -%}
      <span class="product-badge product-badge--soldout">Esgotado</span>
    {%- else -%}
      {%- if on_sale -%}
        <span class="product-badge product-badge--sale">−{{ discount_pct }}%</span>
      {%- endif -%}
      {%- if low_stock_qty > 0 -%}
        {%- if low_stock_qty == 1 -%}
          <span class="product-badge product-badge--last">Último!</span>
        {%- else -%}
          <span class="product-badge product-badge--low">Restam {{ low_stock_qty }}</span>
        {%- endif -%}
      {%- endif -%}
      {%- if is_new -%}
        <span class="product-badge product-badge--new">Novo</span>
      {%- endif -%}
      {%- if is_bestseller -%}
        <span class="product-badge product-badge--bestseller">Mais vendido</span>
      {%- endif -%}
    {%- endif -%}
  </div>

  <button type="button"
          class="product-card__wishlist"
          data-wishlist-toggle="{{ product.handle }}"
          aria-label="Adicionar à lista de desejo"
          aria-pressed="false">
    {% render 'icon-heart' %}
  </button>

  <div class="product-card__body">
    <a href="{{ product.url }}" class="product-card__title-link">
      <h3 class="product-card__title">{{ product.title }}</h3>
    </a>

    <div class="product-card__price">
      {%- if on_sale -%}
        <span class="price__compare">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
      <span class="price__final">{{ product.price | money }}</span>
      {%- if on_sale -%}
        <span class="price__discount">{{ discount_pct }}% off</span>
      {%- endif -%}
    </div>

    <div class="product-card__buttons">
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="product-card__buy"
                {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          {% if product.selected_or_first_available_variant.available %}Comprar{% else %}Esgotado{% endif %}
        </button>
      </form>
      <a href="{{ product.url }}" class="product-card__details">
        Ver detalhes
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>
  </div>
</div>
